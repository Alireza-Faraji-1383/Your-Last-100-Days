	quest.C0FFEE0000000101.title: "Wood Supply Crate"
	quest.C0FFEE0000000102.quest_desc: ["Receive a random food reward. Basic meals are common; golden food is rare."]
	quest.C0FFEE0000000102.title: "Food Supply Crate"
	quest.C0FFEE0000000103.quest_desc: ["Receive a random utility reward. Arrows and torches are common; Ender Pearls and Eyes are rare."]
	quest.C0FFEE0000000103.title: "Utility Supply Crate"
	quest.C0FFEE0000000104.quest_desc: ["Receive a random ore reward. Common ores are frequent; Diamond Ore and Ancient Debris are very rare."]
	quest.C0FFEE0000000104.title: "Ore Supply Crate"
	quest.CF32B419671346B1.quest_desc: ["Finish the final Creeper bounty for the largest reward in this chain."]
	quest.DAD0000000000001.quest_desc: ["Unlock the Trade Post addon path after your colony has a Town Hall. This branch follows the addon advancements from economy into travel, services, pets, and wishes."]
	quest.DAD0000000000001.title: "Trade Post for MineColonies"
	quest.DAD0000000000002.quest_desc: ["Build a level 1 Marketplace. This is the first real Trade Post building and the parent step for coins, services, transport, recycling, and pets."]
	quest.DAD0000000000002.title: "Marketplace"
	quest.DAD0000000000003.quest_desc: ["Obtain your first Trade Coin. This confirms the Marketplace economy is working and starts the currency progression."]
	quest.DAD0000000000003.title: "Big Spender"
	quest.DAD0000000000004.quest_desc: ["Upgrade the currency path by obtaining a Gold Trade Coin. This step follows directly after your first basic Trade Coin."]
	quest.DAD0000000000004.title: "High Roller"
	quest.DAD0000000000005.quest_desc: ["Obtain a Diamond Trade Coin. This completes the Trade Post coin progression from basic coin to the highest-value currency."]
	quest.DAD0000000000005.title: "Bling Bling"
	quest.DAD0000000000006.quest_desc: ["Build a level 1 Recycling Center. This Marketplace branch teaches how the addon turns unwanted items into useful colony value."]
	quest.DAD0000000000006.title: "Recycling Center"
	quest.DAD0000000000007.quest_desc: ["Recycle an item through the Trade Post system. Complete this after building the Recycling Center to prove the mechanic is active."]
	quest.DAD0000000000007.title: "Reduce, Reuse, Recycle"
	quest.DAD0000000000008.quest_desc: ["Build a level 1 Resort. This Marketplace branch introduces tourism, relaxation, and service-based colony support."]
	quest.DAD0000000000008.title: "Resort"
	quest.DAD0000000000009.quest_desc: ["Complete a vacation at the Resort. This follows the Resort build and shows the service loop working."]
	quest.DAD0000000000009.title: "Put Your Feet Up"
	quest.DAD000000000000A.quest_desc: ["Build a level 1 Station. This Marketplace branch opens Trade Post travel, connection, outpost, and rare-find progression."]
	quest.DAD000000000000A.title: "Station"
	quest.DAD000000000000B.quest_desc: ["Connect a colony through the Station system. This follows the Station advancement and proves the transport network is functional."]
	quest.DAD000000000000B.title: "Express Line"
	quest.DAD000000000000C.quest_desc: ["Build a level 1 Outpost after unlocking the Station branch. This expands Trade Post activity beyond the main settlement."]
	quest.DAD000000000000C.title: "Outpost"
	quest.DAD000000000000D.quest_desc: ["Trigger a rare find from the Station branch. Keep the travel network active until the addon rewards exploration and trade luck."]
	quest.DAD000000000000D.title: "Rare Find"
	quest.DAD000000000000E.quest_desc: ["Build a level 1 Pet Shop. This Marketplace branch opens the addon pet-training progression."]
	quest.DAD000000000000E.title: "Pet Shop"
	quest.DAD000000000000F.quest_desc: ["Train a pet through the Pet Shop. Complete this after the Pet Shop to show how pets become functional colony helpers."]
	quest.DAD000000000000F.title: "Train a Pet"
	quest.DAD0000000000010.quest_desc: ["Collect cobblestone, granite, andesite, and diorite. This starts the addon side path that leads into Mixed Stone and wishes."]
	quest.DAD0000000000010.title: "Got Stone?"
	quest.DAD0000000000011.quest_desc: ["Prepare the Wishing Well route with Mixed Stone. This follows Got Stone and sets up the wish mechanic."]
	quest.DAD0000000000011.title: "Make a Wishing Well"
	quest.DAD0000000000012.quest_desc: ["Make one wish through the Trade Post wishing system. This completes the addon wish progression after the Wishing Well step."]
	quest.DAD0000000000012.title: "Make a Wish"
	quest.DAD0000000000013.quest_desc: ["Trigger the Perpetual Stew advancement. This is a root-level Trade Post side milestone separate from the Marketplace building chain."]
	quest.DAD0000000000013.title: "Runs on Stew"
