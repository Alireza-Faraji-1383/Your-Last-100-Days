	quest.0900000000000001.title: "Day 100: Survivor"
	quest.0900000000000004.title: "Master of Netherite"
	quest.0900000000000007.quest_desc: ["Defeat Ignis once more to claim the trophy."]
	quest.0900000000000007.title: "Slayer of Giants"
	quest.090000000000000A.title: "Legend"
	quest.09356B5CE3839F2C.quest_desc: ["Upgrade into the Library of Alexandria through tightly tuned Infusion Enchanting. Keep Eterna and Arcana maxed while holding Quanta in the required narrow range."]
	quest.09356B5CE3839F2C.quest_subtitle: "Utility Route - Ultimate Library"
	quest.09356B5CE3839F2C.title: "Library of Alexandria"
	quest.0A64DCF2FEFE6DBC.quest_desc: ["To hit level 75, you will need to upgrade your Deepshelves. Doing this requires materials only found in the &0Deep Dark&r. &1Echo Shards&r may be looted from the Ancient City, and &1Sculk&r may be collected with Silk Touch."]
	quest.0A64DCF2FEFE6DBC.quest_subtitle: "Reaching Level 75"
	quest.0AB503478883A9BC.quest_desc: ["Infuse a Dormant Deepshelf after the Hell and Sea tiers are stable. Deepshelves move the table into the Deep Dark tier and prepare the path to level 80."]
	quest.0AB503478883A9BC.quest_subtitle: "Step 08 - Deep Dark Tier"
	quest.0AB503478883A9BC.title: "Delving Into Darkness"
	quest.0B009391E3F76D6E.quest_desc: ["Build the Fisherman Hut to add reliable food production. A good fishing setup helps feed citizens while sometimes producing useful extra loot."]
	quest.0B009391E3F76D6E.title: "Fisherman Hut"
	quest.0B1150037754A4EB.quest_desc: ["Infuse Seashelves when the table has enough Eterna, Quanta, and Arcana, then craft Heart-Forged or Crystalline variants. This branch gives the table cleaner high-quality rolls."]
	quest.0B1150037754A4EB.quest_subtitle: "Step 05B - Infused Seashelves"
	quest.0B1150037754A4EB.title: "Sleeping in the Cold Below"
	quest.0BCD3AEC3A4ACC8B.quest_desc: ["Craft or obtain an Enchanting Table to open the Apothic system. The table now shows enchanting stats, supports higher power levels, and becomes the center of every later shelf setup."]
	quest.0BCD3AEC3A4ACC8B.quest_subtitle: "Step 01 - Table Foundation"
	quest.0BCD3AEC3A4ACC8B.title: "The Secrets of Enchanting"
	quest.0BF93E0CDEDCB004.quest_desc: ["Defeat Frostmaw and continue the Mowzie boss route."]
	quest.0BF93E0CDEDCB004.title: "Frostmaw"
	quest.0C5DA84E0E5FD721.quest_desc: ["Build a level 1 Station after logistics are stable. This starts the travel branch and prepares the colony for broader trade connections."]
	quest.0C5DA84E0E5FD721.title: "Station"
	quest.0C6336145194DF5F.quest_desc: ["Continue the Zombie bounty with a larger target. Complete it to unlock the next tier."]
	quest.0CE1F6DE5FD6A6D9.title: "&aEvocation&r Upgrade Orb"
	quest.0D6E099A1A242153.quest_desc: ["Collect the Build Tool and Town Hall block, then place the colony center. This is the foundation for every MineColonies building and the point where your settlement officially begins."]
	quest.0D6E099A1A242153.title: "Found the Colony"
	quest.0D7D0A11D7517585.quest_desc: ["Obtain a Diamond Trade Coin. This completes the Trade Post coin progression from basic coin to the highest-value currency."]
	quest.0D7D0A11D7517585.title: "Bling Bling"
	quest.0DA09629733D2F68.quest_desc: ["At this stage, there are a few basic options for increasing other stats. you can use Candles to increase &5Arcana&r, Skulls to increase &cQuanta&r, and Amethyst Clusters to increase &eQuantic Stability&r."]
	quest.0DA09629733D2F68.quest_subtitle: "Reaching Level 30 is done in the usual way, with fifteen bookshelves."
	quest.0DA09629733D2F68.title: "Level 30"
	quest.0DB241AA8AB171C9.quest_desc: ["Find the Soul Blacksmith before challenging the Monstrosity."]
	quest.0DB241AA8AB171C9.title: "Soul Blacksmith"
	quest.0DD8CE32CA2D3810.quest_desc: ["Build the Spellstone Table before controlled Spellstone crafting."]
	quest.0DD8CE32CA2D3810.title: "Spellstone Table"
	quest.0DE3777240F80A5D.quest_desc: ["Craft an Enchantment Library. Insert enchanted books to store their enchantments as points, then extract specific levels when you need clean book management."]
	quest.0DE3777240F80A5D.quest_subtitle: "Utility Route - Book Storage"
	quest.0DE3777240F80A5D.title: "Enchantment Library"
	quest.0E594BC58CC7476F.quest_desc: [
		"He may be evil, but he still is fashionable. "
		"{image:irons_spellbooks:textures/quests/spells_outfit_archevoker.png width:60 height:100 align:center}"
	]
	quest.0E594BC58CC7476F.title: "&aArchevoker Outfit"
	quest.0E9ABFF41F038D8B.quest_desc: ["Receive a Mending Mixture after opening the Cursed Ring shop route."]
	quest.0E9ABFF41F038D8B.title: "Mending Mixture"
	quest.0EBB4E5195610A82.quest_desc: ["Build the Sawmill so the Carpenter can craft wood-based items for the colony. Teaching common Builder recipes here reduces manual crafting dramatically."]
	quest.0EBB4E5195610A82.quest_subtitle: "Build a Sawmill"
	quest.0EBB4E5195610A82.title: "Sawmill"
	quest.0EC5A9479172DD7C.quest_desc: ["Train a pet through the Pet Shop. Finish this step to turn a cute companion into useful colony support."]
	quest.0EC5A9479172DD7C.title: "Train a Pet"
	quest.0EED5D755D2C866A.quest_desc: ["&d&lEnder&r is used for taking all the powers of &dEndermen&r and the &dEnder Dragon&r, and of course using it for ourselves. &dTeleporting&r, &dFireballs&r, and &dDragon's Breath&r are only a few of these! \n\n&d&lEnder's&r Focus Material is the &dEnder Pearls&r. \n\nAnd its &dScrolls&r are &5Purple&r with &dPink&r text."]
	quest.0EED5D755D2C866A.title: "&d&lEnder"
	quest.0F409DACBEB7BBF8.quest_desc: ["Place or prepare a Supply Ship as an alternate colony start. It provides early resources, but it needs enough open space and careful placement to deploy correctly."]
	quest.0F409DACBEB7BBF8.title: "Supply Ship"
	quest.0FCC32F686193F78.quest_desc: [
		"Tomes are a special type of Book. A Tome can be enchanted just like a book, but can only receive specific enchantments."
		""
		"Once you enchant a tome, it will transform into an enchanted book."
	]
	quest.0FCC32F686193F78.title: "Tomes"
	quest.10B41FCF6D3D548C.quest_desc: ["Build a level 1 Pet Shop after the colony has proper housing. This opens the functional pet branch for companion-based support."]
	quest.10B41FCF6D3D548C.title: "Pet Shop"
	quest.11274B9716914F83.quest_desc: ["Forge Etherium Ingots after Astral Dust."]
	quest.11274B9716914F83.title: "Etherium Ingot"
	quest.113615E96E320BB0.quest_desc: ["Trigger a rare Trade Post find through the travel network. Keep the Station branch active until a valuable discovery appears."]
	quest.113615E96E320BB0.title: "Rare Find"
	quest.117DC5DDBE26FF9E.quest_subtitle: "Reaching Level 90"
	quest.11872459EE2E3A0B.quest_desc: [
		"Apothic Enchanting includes several tools and collectibles outside the normal bookshelf progression."
		""
		"Begin with a Flimsy Ender Lead, then complete the four surrounding specialist quests."
	]
	quest.11872459EE2E3A0B.quest_subtitle: "Beyond the shelf tree"
	quest.11872459EE2E3A0B.title: "Ender Binding"
	quest.11A858C09DB25C9B.quest_desc: ["Craft a Tome of Extraction. This is the clean version of the scrapping path: it removes all enchantments while keeping the original item intact."]
	quest.11A858C09DB25C9B.quest_subtitle: "Utility Route - Safe Extraction"
	quest.11A858C09DB25C9B.title: "Tome of Extraction"
	quest.11A8C08EA0F615E3.quest_desc: ["Build a level 1 Recycling Center. Use it to convert clutter and low-value stock into useful output for the colony supply chain."]
	quest.11A8C08EA0F615E3.title: "Recycling Center"
	quest.120152510AD4B59A.quest_desc: ["Obtain Build Goggles to preview higher-level building shapes. They help plan layouts before committing resources to upgrades."]
	quest.120152510AD4B59A.quest_subtitle: "Itâ€™s A Samsquanch!"
	quest.120152510AD4B59A.title: "Build Goggles"
	quest.128AB24F072E82BD.quest_desc: ["Defeat the Ender Guardian and finish the void route."]
	quest.128AB24F072E82BD.title: "Ender Guardian"
	quest.130E8FC7479E4271.quest_desc: ["Craft the Shepherd hut block to raise sheep. This supports wool production and adds another stable food source once animals are supplied."]
	quest.130E8FC7479E4271.title: "Shepherd Hut"
	quest.1326AD9EC7A362E8.quest_desc: ["Defeat Ignis and finish the flame route."]
	quest.1326AD9EC7A362E8.title: "Ignis"
	quest.132AF80A62FFF98D.quest_desc: ["Build the Tavern to house visitors and recruit new citizens. This is one of the strongest early buildings for growing your workforce beyond the starting colonists."]
	quest.132AF80A62FFF98D.title: "Tavern"
	quest.13C5FAB90F6EAACA.quest_desc: ["Craft or find a Cursed Scroll after mastering the darker scroll path."]
	quest.13C5FAB90F6EAACA.title: "Cursed Scroll"
	quest.13E31601F723D2DD.quest_desc: [
		"The &dGeode Shelf&r is the compatible third shelf route in this version. It replaces RAD3's unavailable Aether Skyshelf branch."
		""
		"Craft it with a Bookshelf, Calcite, and Budding Amethyst to gain Quantic Stability for precise Infusion Enchanting setups."
	]
	quest.13E31601F723D2DD.quest_subtitle: "The compatible third shelf"
	quest.13E31601F723D2DD.title: "The Geode Shelf"
	quest.13F77C38AC015E9F.quest_desc: [
		"High above the Mountains, high above the Clouds rests another &bTower&r. This one giving you shivers down your spine. \n\nThe &bTower&r is made of Stone, Dark Oak, and Deepslate. It has a second Tower branching off of it. There is a staircase on the outside that leads to the first floor. From there you can climb the inside staircase to go up to the bedroom or second tower. \n\nOr you can venture behind that staircase down the Ladder to the Basement, where the &b&lCryomancer&r will most likely be. \n\nIn the &bTower&r you can find Inscription Tables, Amethyst, and Loot Chests!"
		"{image:irons_spellbooks:textures/quests/spells_mountaintower.png width:200 height:100 align:center}"
	]
	quest.13F77C38AC015E9F.title: "&bMountain Tower"
	quest.1447D48FBE3286B6.quest_desc: ["Upgrade the currency path by obtaining a Gold Trade Coin. This step follows directly after your first basic Trade Coin."]
	quest.1447D48FBE3286B6.title: "High Roller"
	quest.149C8729A5AF48A5.quest_desc: ["Start the Trade Post branch after establishing a Town Hall. This addon expands your colony with trade, travel, recycling, pets, tourism, and wishes."]
	quest.149C8729A5AF48A5.title: "Trade Post Charter"
	quest.14DA3DC7C0009A6A.quest_desc: ["Grow the colony to fifty citizens. This is a major midgame settlement milestone that requires stable housing and jobs."]
	quest.14DA3DC7C0009A6A.title: "Population 50"
	quest.150B22BC04F1A682.quest_desc: ["Smelt iron to unlock reliable tools and the next mining tier."]
	quest.150B22BC04F1A682.title: "First Iron"
	quest.153216DF47821D6F.quest_desc: ["Infuse Hellshelves once your table reaches the Hell infusion requirements, then craft Blazing or Glowing Hellshelves. This branch pushes power and Quanta toward level 60."]
	quest.153216DF47821D6F.quest_subtitle: "Step 05A - Infused Hellshelves"
	quest.153216DF47821D6F.title: "Mastering the Inferno"
	quest.154F2CD44BB7EC38.quest_desc: ["Find the Ancient Factory before challenging the Harbinger."]
	quest.154F2CD44BB7EC38.title: "Ancient Factory"
	quest.1552D2ED4A036712.quest_desc: ["Finish the final Piglin Brute bounty for the largest reward in this chain."]
	quest.155725BD5EEF4DB4.quest_desc: ["Find the Sunken City before challenging the Leviathan."]
	quest.155725BD5EEF4DB4.title: "Sunken City"
	quest.159A20BC9424EADC.quest_desc: ["Find the Acropolis before challenging Scylla."]
	quest.159A20BC9424EADC.title: "Acropolis"
	quest.15B51FB56A64C303.quest_desc: ["Craft the University hut block to unlock research. Research controls many later buildings, upgrades, and colony improvements, so this is a major progression step."]
	quest.15B51FB56A64C303.title: "University"
	quest.15F03A5E7E14C022.quest_desc: ["Build the Stonemason to craft stone-based blocks for Builders. This is a key production building for upgrades that require large amounts of refined stone."]
	quest.15F03A5E7E14C022.quest_subtitle: "Build a Stonemason's Hut"
	quest.15F03A5E7E14C022.title: "Stonemason"
	quest.160CD8B65B2BD16B.quest_desc: ["Defeat the Kraken and unlock its flawless challenge."]
	quest.160CD8B65B2BD16B.title: "Kraken"
	quest.17371E278B5E8441.quest_desc: ["Claim The Cube after completing the core Spellstone collection."]
	quest.17371E278B5E8441.title: "The Cube"
	quest.1738A11EB21B6E74.quest_desc: ["Obtain a Bow Tome to focus enchanting results toward bows."]
	quest.1738A11EB21B6E74.quest_subtitle: "Ranged enchantments"
	quest.1738A11EB21B6E74.title: "Tome of the Archers"
	quest.179F0314EF6F15F9.quest_desc: ["Obtain the Storm Eye to begin the skyward route."]
	quest.179F0314EF6F15F9.title: "Storm Eye"
	quest.17AB0649B90CFE9B.quest_desc: ["Defeat the Ferrous Wroughtnaut and continue the Mowzie boss route."]
	quest.17AB0649B90CFE9B.title: "Ferrous Wroughtnaut"
	quest.18F224F39CFD0B35.quest_desc: ["Gather Ichor after Infernal Cinder to unlock the darker material chain."]
	quest.18F224F39CFD0B35.title: "Ichor Droplet"
	quest.19542103E042BDB5.quest_desc: ["{image:irons_spellbooks:textures/quests/spells_outfit_shadow.png width:60 height:100 align:center}"]
	quest.19542103E042BDB5.title: "&dShadow-Walker Outfit"
	quest.19D03831EB5EED02.quest_desc: ["Build the Blacksmith to craft tools, weapons, and armor for the colony. Teach it the recipes your workers and guards need most often."]
	quest.19D03831EB5EED02.quest_subtitle: "Build a Blacksmith Hut"
	quest.19D03831EB5EED02.title: "Blacksmith"
	quest.1A0368CB49B8CBFF.quest_desc: ["This &eSpell Book&r is a rare drop from &cBlazes&r. I remember that because I was confused when I got 1 from my &cBlaze&r Farm. \n\nIt gives a Boost to &cFire Spells&r and has 10 &3Spell&r Slots."]
	quest.1A0368CB49B8CBFF.title: "&cBlaze Instruction Manual"
	quest.1AFB23B86AFA4C64.quest_desc: ["Enchant an item at 0% Quanta. Low Quanta removes chaotic swings and is best when you want predictable results instead of gambling on variance."]
	quest.1AFB23B86AFA4C64.quest_subtitle: "Stat Route - Clean Rolls"
	quest.1AFB23B86AFA4C64.title: "Begone, Flux"
	quest.1B416F55DB53C59C.quest_desc: ["Hunt Creepers to start this bounty chain. The next tier asks for a larger kill count."]
	quest.1B8F8360FA7CAB0D.quest_desc: ["Receive Silver Coins for regular shop use."]
	quest.1B8F8360FA7CAB0D.title: "Gold to Silver Exchange"
	quest.1BA9D21E423F5547.quest_subtitle: "Clues +2"
	quest.1BAE0E9F2EF84463.quest_desc: ["Build a level 1 Marketplace after your basic delivery network is running. This becomes the economic hub for Trade Coins and addon buildings."]
	quest.1BAE0E9F2EF84463.title: "Marketplace"
	quest.1BE69992D2C5085B.quest_desc: ["&n&aEvocation:&r\nTo invoke a Spirit or Deity. \n\n&a&lEvokation&r is all about what &aEvokers&r do, mainly summoning. Whether it be &aFangs&r or &aVexes&r if it's summoned it's most likely an &aEvokation&r. \n\n&a&lEvokation's&r Focus Material is &aEmeralds&r. You can either craft the Rune or get it from the &a&lArchevoker&r. \n\n&aEvokation Scrolls&r are &fWhite&r with &0Black&r texts."]
	quest.1BE69992D2C5085B.title: "&a&lEvocation"
	quest.1C16AEE8E29FB5A0.quest_desc: ["Obtain a Rallying Banner to command guards during threats. Bind it to towers so defenders can respond when raids or emergencies happen."]
	quest.1C16AEE8E29FB5A0.title: "Rally Banner"
	quest.1C47017E1661966A.quest_desc: ["Acquire an Abyssal Heart after The Twist."]
	quest.1C47017E1661966A.title: "Abyssal Heart"
	quest.1CA6332B5CCCF7A5.quest_desc: [
		"An Enchantment Library is a storage system for Enchantments. Simply insert enchanted books, and every enchantment on the book will be stored as points."
		""
		"Each library has a Level Capacity, representing the highest level of enchantment it can store. Excess enchantments are voided."
		""
		"Clicking on a stored enchantment will extract one level of that enchantment. Shift-clicking a stored enchantment will extract as many levels as possible. Books are generated in the output slot as necessary."
	]
	quest.1CAEC4C273EDDB99.quest_desc: ["It's here! It's there! It's everywhere and it's rotten! You can find these in most Chests. \n\nThey can hold 8 &3Spells&r but give you less Spell Resistance."]
	quest.1CAEC4C273EDDB99.title: "Rotten Spell Book"
	quest.1D21918DEB56B1A6.quest_desc: ["Obtain the Cursed Eye to open the Frosted Prison route."]
	quest.1D21918DEB56B1A6.title: "Cursed Eye"
	quest.1D7F6CDB5830460A.quest_desc: ["Receive a repeatable artifact or relic reward. The reward is claimed automatically."]
	quest.1D7F6CDB5830460A.title: "Artifact Cache"
	quest.1DCA014C0D986B5E.quest_desc: ["Defeat the Harbinger and secure its Cataclysm rewards."]
	quest.1DCA014C0D986B5E.title: "The Harbinger"
	quest.1E133F29216F6E4A.quest_desc: ["Defeat Scylla and claim the storm route reward."]
	quest.1E133F29216F6E4A.title: "Scylla"
	quest.1E1870FAD295DEDE.quest_desc: ["Place or prepare a Supply Camp as a starting route for your colony. Clear enough terrain first, then use the preview controls to position it cleanly."]
	quest.1E1870FAD295DEDE.title: "Supply Camp"
	quest.1E771F8D69CD355D.quest_desc: ["Receive a special cursed reward roll after opening the Cursed Ring shop route."]
	quest.1E771F8D69CD355D.title: "Cursed Relic Cache"
	quest.1F3AB832FE0B45A0.quest_desc: ["Receive a random utility reward. Arrows and torches are common; Ender Pearls and Eyes are rare."]
	quest.1F3AB832FE0B45A0.title: "Utility Supply Crate"
	quest.201CB898A399F1D5.quest_desc: ["Craft the Swineherder hut block to raise pigs for food. Bring animals to the hut so the worker can maintain production."]
	quest.201CB898A399F1D5.title: "Swineherder Hut"
	quest.204B969DA081056A.quest_desc: [
		"These can spawn almost anywhere &2Vanilla&r Hostile Mobs spawn in. They aren't bosses, just more Enemies! \n\nThey have 25 Points of &cHealth&r and have mulitple attacks: &aFangs&r from the ground like what &aEvokers&r do and a &bSnowball&r they can shoot you with. \n\nThey can also summon Zombies and Skeletons to help fight you. These won't drop anything and spawn with Armor from the ground. \n\nThey will drop Arcane Essence on death along with sometimes a &3Scroll&r!"
		"{image:irons_spellbooks:textures/quests/spells_necromancer.png width:100 height:200 align:center}"
	]
	quest.204B969DA081056A.title: "Necromancers"
	quest.206159A3C7A78447.quest_desc: ["Build the Mystical Site to unlock special colony services. It pushes the settlement beyond basic production into more advanced support roles."]
	quest.206159A3C7A78447.quest_subtitle: "Build a Mystical Site"
	quest.206159A3C7A78447.title: "Mystical Site"
	quest.21302453E6311BC9.quest_desc: ["Collect every core Spellstone after establishing the table route."]
	quest.21302453E6311BC9.title: "Spellstone Collection"
	quest.219A93D1B55C768D.quest_desc: ["Obtain the Desert Eye to begin the cursed desert route."]
	quest.219A93D1B55C768D.title: "Desert Eye"
	quest.21AA7D04E58FDD78.quest_desc: ["Build a level 1 Resort after the Tavern path is open. This introduces tourism and comfort as a support system for the colony economy."]
	quest.21AA7D04E58FDD78.title: "Resort"
	quest.2226FC4894277EEB.quest_desc: [
		"During the enchanting process, you spend &aexperience&r and &9Lapis Lazuli&r to enchant an item. From this, enchantments are randomly selected using some complex formulas. This quest explains that process."
		""
		"First, we'll go over how enchantments are selected. Each enchantment has a  &dPower Function&r, which controls what &dFinal  power&r will make a specific level available. Once all the available enchantments are gathered, some are selected randomly based on their weights."
		""
		"&dFinal Power&r is calculated using the following steps: Intially, you have a &6Base Power&r, which is the level you spent while enchanting. Then, &cQuanta&r and &eQuantic Stability&r modify your &6Base Power&r to produce your &dFinal power&r."
		""
		"The specifics of how each stat modifies your &6Base Power&r can be found in the &cQuanta&r and &eQuantic Stability&r entries. Typically, a higher &dFinal Power&r will get you access to higher level enchantments."
	]
	quest.2270662C32BFDF81.quest_desc: ["Enchant an item at level 30. This proves the vanilla baseline is working before you replace ordinary shelves with Apothic shelves for stronger stats."]
	quest.2270662C32BFDF81.quest_subtitle: "Step 03 - Vanilla Baseline"
	quest.2270662C32BFDF81.title: "The Basics"
	quest.23012F6C4C522CEB.quest_desc: ["Build the Lumberjack Hut to create a steady wood supply. Wood is required constantly for building upgrades, tools, decorations, and early automation."]
	quest.23012F6C4C522CEB.title: "Lumberjack Hut"
	quest.2365FE766CBF602F.quest_desc: [
		"Find the record dedicated to Quanta, the enchanting variance stat."
		""
		"This collectible replaces RAD3's unavailable Void Shelf node."
	]
	quest.2365FE766CBF602F.quest_subtitle: "The melody of variance"
	quest.2365FE766CBF602F.title: "Melody of Quanta"
	quest.23C3704D131B2DF1.quest_desc: ["Enchant an item at 100% Quanta. This is the full chaos route and shows the strongest possible random swing before Stability is added."]
	quest.23C3704D131B2DF1.quest_subtitle: "Stat Route - Full Quanta"
	quest.23C3704D131B2DF1.title: "Rolling the Dice"
	quest.23C3ADD73281CAB2.quest_desc: ["Start the Cataclysm path and unlock its boss routes."]
	quest.23C3ADD73281CAB2.title: "Cataclysm Begins"
	quest.24150DE600C2D761.quest_desc: ["This one is single-handly taking us from E10 to Teen rating. &4&lBlood&r is all about slaying enemies for your own &cHealth&r! Most attacks will heal you back. \n\n&4&lBlood's&r Focus Material is &4Blood Vials&r which you get from cooking a Mob or Player in a Cauldron. \n\nIts &4Scrolls&r are Brown (there's no color for Brown) with &4Dark Red&r texts."]
	quest.24150DE600C2D761.title: "&4&lBlood"
	quest.24BAC1C0392E950E.quest_desc: [
		"I heard you can just take online classes to become one now."
		"{image:irons_spellbooks:textures/quests/spells_outfit_priest.png width:60 height:100 align:center}"
	]
	quest.24BAC1C0392E950E.title: "&6Priest Outfit"
	quest.26E4868B7C280A98.quest_desc: ["Use an Escape Scroll after securing recall-based travel."]
	quest.26E4868B7C280A98.title: "Emergency Exit"
	quest.272558ECD49E41B3.quest_desc: ["Build a level 1 Outpost. Use it to extend your colony influence and support remote trade activity beyond the main settlement."]
	quest.272558ECD49E41B3.title: "Outpost"
	quest.2768BCABBE854AE2.quest_desc: ["Obtain the Mech Eye to begin the factory route."]
	quest.2768BCABBE854AE2.title: "Mech Eye"
	quest.27EF4C1254D06288.quest_desc: ["Build a level 1 Marketplace. This is the first real Trade Post building and the parent step for coins, services, transport, recycling, and pets."]
	quest.27EF4C1254D06288.title: "Marketplace"
	quest.2830CB386FEDEF1F.quest_desc: ["The last step to Level 80 requires slaying the &0Warden&r, which allows crafting &1Sculkshelves&r."]
	quest.2830CB386FEDEF1F.quest_subtitle: "Reaching Level 80"
	quest.28F188346E50DD6A.quest_desc: ["Receive a random ore reward. Common ores are frequent; Diamond Ore and Ancient Debris are very rare."]
	quest.28F188346E50DD6A.title: "Ore Supply Crate"
	quest.2913D198FA2B860D.quest_desc: ["Complete a vacation at the Resort. Finish this to prove the tourism side of the colony is working end to end."]
	quest.2913D198FA2B860D.title: "Put Your Feet Up"
	quest.2A787B99A8B0C767.quest_desc: [
		"A very important block and a very common one! Can be crafted or found in most &lIron Spells&r Structures. \n\nThese are used for adding and removing &3Scrolls&r from &eSpell Books&r! Throw the &eSpell Book&r in the Book Slot then the &3Scroll&r below it. If you want to remove a &3Scroll&r, click it then take it from the right and into your Inventory."
		"{image:irons_spellbooks:textures/quests/spells_table_gui.png width:150 height:100 align:center}"
	]
	quest.2A7FFD785EAB2DE0.quest_desc: ["Collect cobblestone, granite, andesite, and diorite. This starts the addon side path that leads into Mixed Stone and wishes."]
	quest.2A7FFD785EAB2DE0.title: "Got Stone?"
	quest.2B01B964638DFBD1.quest_desc: ["Craft the Crusher hut block to expand material processing. The Crusher helps break down resources into forms other workers can use."]
	quest.2B01B964638DFBD1.quest_subtitle: "Build a Crusher's Hut"
	quest.2B01B964638DFBD1.title: "Crusher Hut"
	quest.2B42A1CB36B3751A.quest_desc: ["Create obsidian and prepare for stronger crafting and portals."]
	quest.2B42A1CB36B3751A.title: "Obsidian Work"
	quest.2B490712D752F2AA.quest_desc: ["Continue the Skeleton bounty with a larger target. Complete it to unlock the next tier."]
	quest.2B901ECF97FFA181.quest_desc: ["When you finally combine the Ancient Knowledge Fragments you'll get the... &9Eldritch Manuscript&r! That's what the last class is! \n\n&9Eldritch&r is the last class, the most powerful of all &3Spells&r. They are crafted with &9Echo Shards&r and need to be learned from the &9Manuscript&r to use them. Each &9Manuscript&r is only one use."]
	quest.2B901ECF97FFA181.title: "&9&lEldritch"
	quest.2BB910B217DF3A12.title: "&dEnder&r Upgrade Orb"
	quest.2C039F5007E909A4.quest_desc: ["Defeat the Sandworm without taking a hit for a mastery reward."]
	quest.2C039F5007E909A4.title: "Flawless Sandworm"
	quest.2C0EC05D1BEA77B1.quest_desc: ["Find a Woodland Mansion and secure its survival rewards."]
	quest.2C0EC05D1BEA77B1.title: "Woodland Mansion"
	quest.2C9F7712321854BE.quest_desc: ["Begin the adventure path and prepare to seek dangerous structures."]
	quest.2C9F7712321854BE.title: "Adventure Calls"
	quest.2D3422284A9EFF23.quest_desc: ["Accept the Cursed Ring path before opening the deeper relic routes."]
	quest.2D3422284A9EFF23.title: "Wear the Curse"
	quest.2D875F9BAD35800F.quest_desc: [
		"Once you reach Level 45, you'll need to explore &5Infusion Enchanting&r to upgrade your shelves."
		""
		"Create a few more of the type of shelf you were using, infuse them, and upgrade them. These new shelves, on top of your old ones, will let you reach Level 60."
	]
	quest.2DDFBA95A9138CA4.quest_desc: ["Craft the Twisted Mirror after the Twisted Heart."]
	quest.2DDFBA95A9138CA4.title: "Twisted Mirror"
	quest.2E6F1C8718EB8C66.title: "&4Blood&r Upgrade Orb"
	quest.2F1B0D8E1D18AB3C.quest_desc: ["Craft the full iron tool set as your reliable early kit."]
	quest.2F1B0D8E1D18AB3C.title: "Iron Toolkit"
	quest.3002F31614B0F257.quest_desc: ["Enchant with at least 10 Eterna, Quanta, and Arcana. Eterna sets the level, Quanta changes the amount of randomness, and Arcana improves rare enchantments and extra rolls."]
	quest.3002F31614B0F257.quest_subtitle: "Step 07 - Read the Table Stats"
	quest.3002F31614B0F257.title: "Eterna, Quanta, Arcana"
	quest.3009018DEC1EC952.quest_desc: ["There's 6 structures in the &2Overworld&r that the bosses can spawn in! (There's a 7th but no boss in there)."]
	quest.3009018DEC1EC952.title: "&lAdventure Time!"
	quest.300F2E45D185A9A1.quest_desc: ["&lIron&r has brought us a wonderful and very fun Magic Mod! &lIron's Spells 'N Spellbooks!&r \n\n&lIron's Spells&r is all about making and using &3Spells&r! Each &3Spell&r has a Rarity, Level, and Class! And everyone of them can be used in a Spellbook. \n\nYou won't be able to just make whatever you want with &7Iron&r and &cRedstone&r, you'll need to get off your butt, Adventure, and Fight!"]
	quest.300F2E45D185A9A1.title: "&lIron's Spells 'N Spellbooks"
	quest.30B7AF815D9D7553.quest_desc: [
		"The &cBurned Tower&r of the &c&lPyromancer&r. Some say if you're close enough to see the &cTower&r, then you're close enough to feel the heat from it. \n\nThe &cPyromancer Tower&r is a burned tower of mainly Stone types with the inside being made of Spruce and Oak. There is also a second Building close to the &cTower&r that is part of the structure as well. \n\nAt the top you will find what's causing the smoke as well as an &5Armor Pile&r. \n\nIf you'd like to find the &c&lPyromancer&r you'll need to venture down into the Basement!"
		"{image:irons_spellbooks:textures/quests/spells_pyromancertower.png width:200 height:100 align:center}"
	]
	quest.30B7AF815D9D7553.title: "&cPyromancer Tower"
	quest.31A3BDCF12B7AF43.quest_desc: ["Enchant an item at level 80. Use Deepshelf and Sculkshelf progression to break past the Hell and Sea ceiling before entering End-tier enchanting."]
	quest.31A3BDCF12B7AF43.quest_subtitle: "Step 10 - Level 80 Enchanting"
	quest.31A3BDCF12B7AF43.title: "Enchantments from the Depths"
	quest.32546F7C7B7AFC83.quest_desc: ["Build a level 1 Resort. This adds tourism and relaxation to the colony, creating a new support path beyond production buildings."]
	quest.32546F7C7B7AFC83.title: "Resort"
	quest.326677DEA12C0398.quest_desc: ["Continue the Creeper bounty with a larger target. Complete it to unlock the next tier."]
	quest.32D2CE292E088939.title: "&cFire&r Upgrade Orb"
	quest.32F975D288A18F4A.quest_desc: ["Train a pet through the Pet Shop. This shows how the addon turns pets from flavor into useful colony helpers."]
	quest.32F975D288A18F4A.title: "Train a Pet"
	quest.33058894ACD9CB06.quest_desc: ["Craft the Graveyard hut block to support death recovery systems. This gives the colony a proper way to handle losses and related duties."]
	quest.33058894ACD9CB06.quest_subtitle: "Build a Graveyard"
	quest.33058894ACD9CB06.title: "Graveyard Hut"
	quest.338AAED917FC8BD1.quest_desc: ["Receive a random ore reward. Common ores are frequent; Diamond Ore and Ancient Debris are very rare."]
	quest.338AAED917FC8BD1.title: "Ore Supply Crate"
	quest.33BA6855BBED8FEA.quest_desc: ["Claim The Bless after proving the Sacred Crystal route."]
	quest.33BA6855BBED8FEA.title: "The Bless"
	quest.342A1EF584823D2C.quest_desc: ["Teach the colony how to craft torches. This helps Builders request and use basic lighting without relying on you to craft every piece manually."]
	quest.342A1EF584823D2C.title: "Teach Torches"
	quest.342F9A4A1E8BE362.quest_subtitle: "The modern replacement for Rectifier III"
	quest.342F9A4A1E8BE362.title: "Maximum Quantic Stability"
	quest.3460E28FAD1187CA.quest_desc: ["Craft the full diamond tool set to finish the core mining tier."]
	quest.3460E28FAD1187CA.title: "Diamond Toolkit"
	quest.34D1EAED46BB61BE.quest_desc: [
		"Enchantment Tomes focus enchanting results toward a particular equipment category."
		""
		"Collect the specialist tomes and utilities in this side tree. It replaces RAD3's unavailable Evil Enchanting branch."
	]
	quest.34D1EAED46BB61BE.quest_subtitle: "Focused enchanting"
	quest.34D1EAED46BB61BE.title: "Specialized Tomes"
	quest.34D7731987C3DE5A.quest_desc: ["Collect cobblestone, granite, andesite, and diorite. These materials start the mixed-stone route toward Trade Post wishing mechanics."]
	quest.34D7731987C3DE5A.title: "Got Stone?"
	quest.351792A9531ADFF4.quest_desc: ["Amethyst is the modern source of &eQuantic Stability&r. Start by obtaining an Amethyst Cluster, which can stabilize the negative side of Quanta."]
	quest.351792A9531ADFF4.title: "Amethyst Stability"
	quest.359B4C333CD4394A.quest_desc: ["Enchant with maximum Eterna, Quanta, and Arcana. This proves the table can reach full power, full chaos, and full rare-enchantment quality at the same time."]
	quest.359B4C333CD4394A.quest_subtitle: "Endgame Route - Max Stats"
	quest.359B4C333CD4394A.title: "Maximum Strength"
	quest.360E9E02A494217C.quest_desc: ["Build a Barracks Tower to extend organized military coverage. It strengthens your defensive network beyond individual guard posts."]
	quest.360E9E02A494217C.title: "Barracks Tower"
	quest.367899B66A4BC30F.quest_desc: ["Finish the final Pillager bounty for the largest reward in this chain."]
	quest.3694D22867FF07EF.quest_desc: ["Build a level 1 Station. This begins the travel and logistics branch for connecting the colony to wider trade routes."]
	quest.3694D22867FF07EF.title: "Station"
	quest.36CFAF2E18974908.quest_desc: ["Receive Silver Coins for regular shop use."]
	quest.36CFAF2E18974908.title: "Copper to Silver Exchange"
	quest.36F87173D8CD1D68.quest_desc: ["Ride the &5Lightning&r! &5&lLightning&r is all about using Electricity to kill and support yourself. Some attacks even work as real &5Lightning&r! \n\n&5&lLightning's&r Focus Material is &5Bottle 'O Lightning&r which you get from using an Empty Bottle on a Charged Creeper. You need the &5Lightning&r to make more &5Lightning&r! \n\nIts &5Scrolls&r are &7Grey&r with &bLight Blue&r text."]
	quest.36F87173D8CD1D68.title: "&5&lLightning"
	quest.37BE190EE466D697.quest_desc: ["Upgrade the Town Hall to level 5. This is a major administrative milestone and proves the colony has reached a mature build stage."]
	quest.37BE190EE466D697.title: "Town Hall Level 5"
	quest.37E43341FA234E84.quest_desc: ["Build the Florist to supply flowers, dyes, and decorative resources. This adds a softer production branch that still supports many recipes."]
	quest.37E43341FA234E84.quest_subtitle: "Build a Flower Shop"
	quest.37E43341FA234E84.title: "Florist"
	quest.38037091D6488B24.quest_desc: ["Obtain a Helmet Tome to focus enchanting results toward helmets."]
	quest.38037091D6488B24.quest_subtitle: "Headgear enchantments"
	quest.38037091D6488B24.title: "Tome of Helmets"
	quest.3831CD0CAEEE8E4F.quest_desc: ["Defeat the Underworld Knight and unlock its flawless challenge."]
	quest.3831CD0CAEEE8E4F.title: "Underworld Knight"
	quest.38E7B79D2C6D8483.quest_desc: ["Enchant an item at level 60. Eterna is the main power stat, so combine upgraded Hell and Sea shelves until the table reaches the next major tier."]
	quest.38E7B79D2C6D8483.quest_subtitle: "Step 06 - Level 60 Enchanting"
	quest.38E7B79D2C6D8483.title: "Mastering Hell and Sea"
	quest.3953AFE08C194E79.quest_desc: [
		"The highest level an Enchanting Table can reach is &6Level 100&r, but only one shelf can provide this much power. Creating such a shelf requires venturing into the outer end to retrieve a &5Dragon Head&r."
		""
		"&5Dragon Heads&r spawn on end ships. You can also find one in the library of an &bAviary&r or simply craft it from dragon scales."
		""
		"A single &dDraconic Endshelf&r provides enough raw strength to boost a table from Level 80 to Level 100. However, it provides no other stat bonuses."
	]
	quest.3953AFE08C194E79.quest_subtitle: "Reaching Level 100"
	quest.395A33977B18B9AD.quest_desc: [
		"After trying to harvest the &5Piles of Armor&r they appear to come back to life as if there was a body using it. \n\nThey have 60 Hearts and they are different from other bosses as they don't use magic, rather I believe they are something made from magic. They will attack using their Sword either by swinging it or charging at you with it. \n\nFrom what I've seen they will attack everything they see besides other &5&lKnights&r! \n\nOnce killed they dropped Netherite Scraps and Cinder Essence, that should definitely be of good use!"
		"{image:irons_spellbooks:textures/quests/spells_knight.png width:100 height:200 align:center}"
	]
	quest.395A33977B18B9AD.title: "&5&lAncient Knight"
