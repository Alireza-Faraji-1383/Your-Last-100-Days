	quest.085F473094778DCD.quest_desc: ["Obtain a Resource Scroll to inspect Builder material requests. Link it to a Builder Hut, then use it to see exactly what resources are missing."]
	quest.085F473094778DCD.quest_subtitle: "Micromanagement at it's finest"
	quest.085F473094778DCD.title: "Resource Scroll"
	quest.08EC21D0F20FBEF8.quest_desc: ["Receive a random food reward. Basic meals are common; golden food is rare."]
