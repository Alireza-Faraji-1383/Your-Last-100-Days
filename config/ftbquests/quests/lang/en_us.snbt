	quest.A100000000000001.title: "The Acknowledgment"
	quest.A100000000000004.quest_desc: ["Discover any Enigmatic scroll before branching into scrollcraft."]
	quest.A100000000000004.title: "First Scroll"
	quest.A100000000000007.quest_desc: ["Craft or find a Cursed Scroll to deepen the risk-reward path."]
	quest.A100000000000007.title: "Cursed Scroll"
	quest.A10000000000000A.quest_desc: ["Acquire an Escape Scroll to add a survival tool to the kit."]
	quest.A10000000000000A.title: "Emergency Exit"
	quest.A10000000000000D.quest_desc: ["Discover a Spellstone to open the relic crafting branch."]
	quest.A10000000000000D.title: "First Spellstone"
	quest.A100000000000010.quest_desc: ["Build the Spellstone Table to begin controlled Spellstone crafting."]
	quest.A100000000000010.title: "Spellstone Table"
	quest.A100000000000013.quest_desc: ["Collect every core Spellstone to complete the relic branch."]
	quest.A100000000000013.title: "Spellstone Collection"
	quest.A100000000000016.quest_desc: ["Acquire a Sacred Crystal to start the rare material route."]
	quest.A100000000000016.title: "Sacred Crystal"
	quest.A100000000000019.quest_desc: ["Gather Astral Dust to unlock Etherium and higher crafting goals."]
	quest.A100000000000019.title: "Astral Dust"
	quest.A10000000000001C.quest_desc: ["Forge Etherium Ingots and prepare for the advanced gear tier."]
	quest.A10000000000001C.title: "Etherium Ingot"
	quest.A10000000000001F.quest_desc: ["Craft the full Etherium armor set before the final Enigmatic goals."]
	quest.A10000000000001F.title: "Etherium Armor"
	quest.A100000000000022.quest_desc: ["Craft an Etherium tool or weapon to finish the offensive branch."]
	quest.A100000000000022.title: "Etherium Arsenal"
	quest.A100000000000025.quest_desc: ["Gather Ichor to unlock the darker crafting branch."]
	quest.A100000000000025.title: "Ichor Droplet"
	quest.A100000000000028.quest_desc: ["Acquire Infernal Cinder to prepare fire-aspected relic crafting."]
	quest.A100000000000028.title: "Infernal Cinder"
	quest.A10000000000002B.quest_desc: ["Collect Evil Essence to advance the hostile relic branch."]
	quest.A10000000000002B.title: "Evil Essence"
	quest.A10000000000002E.quest_desc: ["Use the Unholy Grail and prove you can survive its bargain."]
	quest.A10000000000002E.title: "Unholy Grail"
	quest.A100000000000031.quest_desc: ["Acquire a Twisted Heart to open mirror and late-game relic goals."]
	quest.A100000000000031.title: "Twisted Heart"
	quest.A100000000000034.quest_desc: ["Craft the Twisted Mirror to complete the mobility relic branch."]
	quest.A100000000000034.title: "Twisted Mirror"
	quest.A100000000000037.quest_desc: ["Acquire an Abyssal Heart to unlock the final flight branch."]
	quest.A100000000000037.title: "Abyssal Heart"
	quest.A10000000000003A.quest_desc: ["Craft the Chaos Elytra as the chapter's final movement milestone."]
	quest.A10000000000003A.title: "Chaos Elytra"
	quest.A10000000000003D.quest_desc: ["Complete the major Enigmatic branches to finish this chapter."]
	quest.A10000000000003D.title: "Beyond the Curse"
	quest.A340A7804D65B550.quest_desc: ["Continue the Enderman bounty with a larger target. Complete it to unlock the next tier."]
	quest.A8B76DA8386046AB.quest_desc: ["Hunt Vindicators to start this bounty chain. The next tier asks for a larger kill count."]
	quest.B100000000000001.quest_desc: ["Acquire a Pure Heart after accepting the Cursed Ring path."]
	quest.B100000000000001.title: "Pure Heart"
	quest.B100000000000004.quest_desc: ["Acquire the Darkest Scroll before attempting cursed scrollcraft."]
	quest.B100000000000004.title: "Darkest Scroll"
	quest.B100000000000007.quest_desc: ["Obtain a Recall Potion before relying on emergency escape tools."]
	quest.B100000000000007.title: "Recall Potion"
	quest.B10000000000000A.quest_desc: ["Claim The Twist before pursuing Abyssal relics."]
	quest.B10000000000000A.title: "The Twist"
	quest.B10000000000000D.quest_desc: ["Claim The Cube after completing the core Spellstone collection."]
	quest.B10000000000000D.title: "The Cube"
	quest.B100000000000010.quest_desc: ["Claim The Bless after proving the Sacred Crystal route."]
	quest.B100000000000010.title: "The Bless"
	quest.B100000000000013.quest_desc: ["Claim The Infinitum as the final Abyssal relic milestone."]
	quest.B100000000000013.title: "The Infinitum"
	quest.B3611D956F1604C4.quest_desc: ["Hunt Pillagers to start this bounty chain. The next tier asks for a larger kill count."]
	quest.B4102572534FBA62.quest_desc: ["Continue the Vindicator bounty with a larger target. Complete it to unlock the next tier."]
	quest.B788081CBECA1472.quest_desc: ["Continue the Evoker bounty with a larger target. Complete it to unlock the next tier."]
	quest.BF13ED19626F2933.quest_desc: ["Continue the Piglin Brute bounty with a larger target. Complete it to unlock the next tier."]
	quest.C0FFEE0000000101.quest_desc: ["Receive a random wood reward. Common overworld woods are likely; Nether woods are rarer."]
	quest.C0FFEE0000000101.title: "Wood Supply Crate"
	quest.C0FFEE0000000102.quest_desc: ["Receive a random food reward. Basic meals are common; golden food is rare."]
	quest.C0FFEE0000000102.title: "Food Supply Crate"
	quest.C0FFEE0000000103.quest_desc: ["Receive a random utility reward. Arrows and torches are common; Ender Pearls and Eyes are rare."]
	quest.C0FFEE0000000103.title: "Utility Supply Crate"
	quest.C0FFEE0000000104.quest_desc: ["Receive a random ore reward. Common ores are frequent; Diamond Ore and Ancient Debris are very rare."]
	quest.C0FFEE0000000104.title: "Ore Supply Crate"
	quest.CF32B419671346B1.quest_desc: ["Finish the final Creeper bounty for the largest reward in this chain."]
	quest.DAD0000000000001.quest_desc: ["Unlock the Trade Post addon path after your colony has a Town Hall. This branch follows the addon advancements from economy into travel, services, pets, and wishes."]
	quest.DAD0000000000001.title: "Trade Post for MineColonies"
	quest.DAD0000000000002.quest_desc: ["Build a level 1 Marketplace. This is the first real Trade Post building and the parent step for coins, services, transport, recycling, and pets."]
	quest.DAD0000000000002.title: "Marketplace"
	quest.DAD0000000000003.quest_desc: ["Obtain your first Trade Coin. This confirms the Marketplace economy is working and starts the currency progression."]
	quest.DAD0000000000003.title: "Big Spender"
	quest.DAD0000000000004.quest_desc: ["Upgrade the currency path by obtaining a Gold Trade Coin. This step follows directly after your first basic Trade Coin."]
	quest.DAD0000000000004.title: "High Roller"
	quest.DAD0000000000005.quest_desc: ["Obtain a Diamond Trade Coin. This completes the Trade Post coin progression from basic coin to the highest-value currency."]
	quest.DAD0000000000005.title: "Bling Bling"
	quest.DAD0000000000006.quest_desc: ["Build a level 1 Recycling Center. This Marketplace branch teaches how the addon turns unwanted items into useful colony value."]
	quest.DAD0000000000006.title: "Recycling Center"
	quest.DAD0000000000007.quest_desc: ["Recycle an item through the Trade Post system. Complete this after building the Recycling Center to prove the mechanic is active."]
	quest.DAD0000000000007.title: "Reduce, Reuse, Recycle"
	quest.DAD0000000000008.quest_desc: ["Build a level 1 Resort. This Marketplace branch introduces tourism, relaxation, and service-based colony support."]
	quest.DAD0000000000008.title: "Resort"
	quest.DAD0000000000009.quest_desc: ["Complete a vacation at the Resort. This follows the Resort build and shows the service loop working."]
	quest.DAD0000000000009.title: "Put Your Feet Up"
	quest.DAD000000000000A.quest_desc: ["Build a level 1 Station. This Marketplace branch opens Trade Post travel, connection, outpost, and rare-find progression."]
	quest.DAD000000000000A.title: "Station"
	quest.DAD000000000000B.quest_desc: ["Connect a colony through the Station system. This follows the Station advancement and proves the transport network is functional."]
	quest.DAD000000000000B.title: "Express Line"
	quest.DAD000000000000C.quest_desc: ["Build a level 1 Outpost after unlocking the Station branch. This expands Trade Post activity beyond the main settlement."]
	quest.DAD000000000000C.title: "Outpost"
	quest.DAD000000000000D.quest_desc: ["Trigger a rare find from the Station branch. Keep the travel network active until the addon rewards exploration and trade luck."]
	quest.DAD000000000000D.title: "Rare Find"
	quest.DAD000000000000E.quest_desc: ["Build a level 1 Pet Shop. This Marketplace branch opens the addon pet-training progression."]
	quest.DAD000000000000E.title: "Pet Shop"
	quest.DAD000000000000F.quest_desc: ["Train a pet through the Pet Shop. Complete this after the Pet Shop to show how pets become functional colony helpers."]
	quest.DAD000000000000F.title: "Train a Pet"
	quest.DAD0000000000010.quest_desc: ["Collect cobblestone, granite, andesite, and diorite. This starts the addon side path that leads into Mixed Stone and wishes."]
	quest.DAD0000000000010.title: "Got Stone?"
	quest.DAD0000000000011.quest_desc: ["Prepare the Wishing Well route with Mixed Stone. This follows Got Stone and sets up the wish mechanic."]
	quest.DAD0000000000011.title: "Make a Wishing Well"
	quest.DAD0000000000012.quest_desc: ["Make one wish through the Trade Post wishing system. This completes the addon wish progression after the Wishing Well step."]
	quest.DAD0000000000012.title: "Make a Wish"
	quest.DAD0000000000013.quest_desc: ["Trigger the Perpetual Stew advancement. This is a root-level Trade Post side milestone separate from the Marketplace building chain."]
	quest.DAD0000000000013.title: "Runs on Stew"
	quest.E87F3E42F4200288.quest_desc: ["Hunt Evokers to start this bounty chain. The next tier asks for a larger kill count."]
	quest.EFAE976AF7EE9BB5.quest_desc: ["Continue the Pillager bounty with a larger target. Complete it to unlock the next tier."]
	quest.F0EBC458C9636398.quest_desc: ["Continue the Vindicator bounty with a larger target. Complete it to unlock the next tier."]
	quest.FA4875BC0617EF25.quest_desc: ["Finish the final Vindicator bounty for the largest reward in this chain."]
