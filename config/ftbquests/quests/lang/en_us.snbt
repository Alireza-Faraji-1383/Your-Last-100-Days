	quest.4E7A100000000022.quest_desc: ["Defeat forty Blazes to finish the hunting branch."]
	quest.4E7A100000000022.title: "Blaze Hunter III"
	quest.4E7A100000000023.quest_desc: ["Enter a Bastion Remnant while wearing gold and carrying a safe escape route."]
	quest.4E7A100000000023.title: "Those Were the Days"
	quest.4E7A100000000024.quest_desc: ["Open a naturally generated Bastion chest and escape with the loot."]
	quest.4E7A100000000024.title: "War Pigs"
	quest.4E7A100000000025.quest_desc: ["Discover the Underground Bastion added by Repurposed Structures."]
	quest.4E7A100000000025.quest_subtitle: "Repurposed Structures"
	quest.4E7A100000000025.title: "Buried Bastion"
	quest.4E7A100000000026.quest_desc: ["Enter a Nether City added by Repurposed Structures."]
	quest.4E7A100000000026.quest_subtitle: "Repurposed Structures"
	quest.4E7A100000000026.title: "Blazing City"
	quest.4E7A100000000027.quest_desc: ["Visit all five vanilla Nether biomes."]
	quest.4E7A100000000027.title: "Hot Tourist Destinations"
	quest.4E7A10000000002A.quest_desc: ["Enter the redesigned Nether Fortress generated by YUNG's overhaul."]
	quest.4E7A10000000002A.quest_subtitle: "YUNG's Better Nether Fortresses"
	quest.4E7A10000000002A.title: "A Terrible Fortress"
	quest.4E7A10000000002B.quest_desc: ["Defeat a Blaze and obtain a Blaze Rod."]
	quest.4E7A10000000002B.title: "Into Fire"
	quest.4E7A10000000002C.quest_desc: ["Craft a Brewing Stand to turn Nether ingredients into useful potions."]
	quest.4E7A10000000002C.title: "Local Brewery"
	quest.4E7A10000000002D.quest_desc: ["Craft an Eye of Ender from Blaze Powder and an Ender Pearl."]
	quest.4E7A10000000002D.title: "Eye Spy"
	quest.4E7A10000000002E.quest_desc: ["Activate a Stronghold portal and enter the End. Continue the journey in the End-related quests."]
	quest.4E7A10000000002E.title: "Enter the End"
	quest.4E7A10000000002F.quest_desc: ["Mine Ancient Debris from the lower layers of the Nether."]
	quest.4E7A10000000002F.title: "Hidden in the Depths"
	quest.4E7A100000000030.quest_desc: ["Combine four Netherite Scraps and four Gold Ingots. Only vanilla Netherite is used in this chapter."]
	quest.4E7A100000000030.title: "Netherite Ingot"
	quest.4E7A100000000031.quest_desc: ["Wear a complete set of vanilla Netherite armor. The lower upgraded-Netherite wheel is intentionally left empty."]
	quest.4E7A100000000031.title: "Cover Me in Debris"
	quest.4E7A100000000032.quest_desc: ["Obtain a Wither Skeleton Skull. Three are required to summon the Wither."]
	quest.4E7A100000000032.title: "Spooky Scary Skeleton"
	quest.4E7A100000000033.quest_desc: ["Summon and defeat the Wither in a controlled arena."]
	quest.4E7A100000000033.title: "Withering Heights"
	quest.4E7A100000000034.quest_desc: ["Claim the Nether Star dropped by the Wither."]
	quest.4E7A100000000034.title: "Nether Star"
	quest.4E7A100000000035.quest_desc: ["Craft a Beacon from the Nether Star, glass, and obsidian."]
	quest.4E7A100000000035.title: "Bring Home the Beacon"
	quest.4FAD724CA501BB15.quest_desc: ["Create a Bookshelf and learn table placement. Valid stat blocks sit in the two rings around the table, on the same level or one block higher, with air between the shelf and table."]
	quest.4FAD724CA501BB15.quest_subtitle: "Step 02 - Shelf Placement"
	quest.4FAD724CA501BB15.title: "Local Librarian"
	quest.4FFE28F3DB5EC162.quest_desc: [
		"There are multiple methods to perform disenchanting."
		""
		"&5Tome of Extraction&r removes enchantments while preserving the original item."
		""
		"&5Tome of Scrapping&r costs a few levels, destroys the item, and returns half the enchantments, rounded up, on a book."
		""
		"&5Tome of Superior Scrapping&r costs a lot of levels, destroys the item, but returns all of the enchantments."
	]
	quest.4FFE28F3DB5EC162.title: "Extracting Enchantments"
	quest.50AECE055AD40AAF.quest_desc: ["Connect a colony through the Station system. This turns Trade Post from a local market into a true transport network."]
	quest.50AECE055AD40AAF.title: "Express Line"
	quest.51220C5BC6F1F179.quest_desc: ["Receive a random wood reward. Common overworld woods are likely; Nether woods are rarer."]
	quest.51220C5BC6F1F179.title: "Wood Supply Crate"
	quest.517F851353600623.quest_desc: [
		"Once you reach Level 45, you'll need to explore &5Infusion Enchanting&r to upgrade your shelves."
		""
		"Create a few more of the type of shelf you were using, infuse them, and upgrade them. These new shelves, on top of your old ones, will let you reach Level 60."
	]
	quest.51DCE7CCB7BE3A57.quest_desc: ["Craft the Chaos Elytra after the Abyssal Heart."]
	quest.51DCE7CCB7BE3A57.title: "Chaos Elytra"
	quest.52453550206EC770.quest_desc: ["Craft the Dyer hut block to add dye and color production. This supports decoration, recipes, and later colony crafting needs."]
	quest.52453550206EC770.title: "Dyer Hut"
	quest.52C9E92A9CC991F8.quest_desc: ["Receive a premium relic roll from the top regular cache in the shop."]
	quest.52C9E92A9CC991F8.title: "Premium Relic Cache"
	quest.537A8F99CC3F525D.quest_desc: ["Grow the colony military to eight guards. This is the first real defensive threshold for a settlement that expects trouble."]
	quest.537A8F99CC3F525D.title: "Eight Guards"
	quest.53AB7EFD8D1A6F5E.quest_desc: ["Discover any Enigmatic scroll to open the scrollcraft branch."]
	quest.53AB7EFD8D1A6F5E.title: "First Scroll"
	quest.53F8923B85A8A9CC.quest_desc: ["Grow the colony military to eighty guards. This represents a large, fortified settlement ready for serious threats."]
	quest.53F8923B85A8A9CC.title: "Eighty Guards"
	quest.541446863A72B96C.title: "&7Common&r Ink"
	quest.548F85EE6B6F1811.quest_desc: [
		"Just like the Piglins the &2&lApotheocarist&r resembles, he is also Neutral. He doesn't care about &eGold&r like his fellow Piglins though, just people who attack him. \n\nYou can trade with him: giving him either Emeralds or Potion Ingrediants for Potions, Potion Ingrediants, and &2Nature Scrolls&r. \n\nIf you wish to slay him he has 60 Hearts. He will attack you with Potions and &2Nature Spells&r. When hurt he will try to heal with Potions, (I think he really likes Potions). \n\nWhen killed he will drop Arcane Essence, Inks, &2Nature Runes&r, and &2Nature Scrolls&r!"
		"{image:irons_spellbooks:textures/quests/spells_apothecarist.png width:100 height:200 align:center}"
	]
	quest.548F85EE6B6F1811.title: "&2&lApothecarist"
	quest.551A4916F032ACCF.quest_desc: [
		"The Arcane Anvil has the most uses out of any block in &lIron Spells&r. \n\nYou can combine &3Spells&r with the same Ink to level it up. \nIt can combine &3Scrolls&r into Weapons to be used with them, like a Sword. \nYou can also set an Affinity to Rings using Upgrade Orbs, or add Upgrade Orbs to Weapons and Gear."
		"{image:irons_spellbooks:textures/quests/spells_anvil_gui.png width:100 height:100 align:center}"
	]
	quest.552A5BBC9AC53420.quest_desc: ["Defeat Maledictus and close the frozen branch."]
	quest.552A5BBC9AC53420.title: "Maledictus"
	quest.555ED1E39131D91B.quest_desc: [
		"Shouldn't have come into the &bTower&r, the &b&lCryomancer&r does not like Players, they are Hostile to you. \n\nThe &b&lCryomancer&r will immediately start attacking you with &bIce Spells&r. Might even use animals against you! Sacrificing animals to win a fight, he really is cold-hearted! \n\nOnce killed he will drop Arcane Essence, Inks, &bIce Runes&r, and &bIce Scrolls&r."
		"{image:irons_spellbooks:textures/quests/spells_cryomancer.png width:100 height:200 align:center}"
	]
	quest.555ED1E39131D91B.title: "&b&lCryomancer"
	quest.5626294477EA4DCB.quest_desc: ["Find a Better Stronghold and prepare for the End route."]
	quest.5626294477EA4DCB.title: "Stronghold Trail"
	quest.562C9082EA53DE02.quest_desc: ["Finish the final Evoker bounty for the largest reward in this chain."]
	quest.56F019E26B073560.quest_desc: ["Unlock the Trade Post addon path after your colony has a Town Hall. This branch follows the addon advancements from economy into travel, services, pets, and wishes."]
	quest.56F019E26B073560.title: "Trade Post for MineColonies"
	quest.5707E1C306DE7F69.quest_desc: ["Survive a Trial Chamber and bring back its key."]
	quest.5707E1C306DE7F69.title: "Trial Chamber"
	quest.57C889EC980D33D9.quest_desc: ["Build the Farmer Hut and start crop production for the colony. Farming is the backbone of long-term food supply and supports later cooking chains."]
	quest.57C889EC980D33D9.title: "Farmer Hut"
	quest.583A7AA84FEC027F.quest_desc: ["Build the Builder Hut so your colony can construct and upgrade structures. The Builder is the worker that turns your plans into actual buildings."]
	quest.583A7AA84FEC027F.quest_subtitle: "Say that 10 times real fast! "
	quest.583A7AA84FEC027F.title: "Builder Hut"
	quest.58B729AF39986B86.quest_desc: ["Create an Echoing or Soul-Touched Sculkshelf with a Warden Tendril. Sculk shelves add late-game stats and Enchanting Clues, which reveal more of a roll before you commit."]
	quest.58B729AF39986B86.quest_subtitle: "Step 09 - Warden-Tier Shelves"
	quest.58B729AF39986B86.title: "Embracing the Sculk"
	quest.58B7D24C1A208A0A.quest_desc: ["Craft or obtain Mixed Stone and prepare the Wishing Well path. This sets up the special wish mechanics from Trade Post."]
	quest.58B7D24C1A208A0A.title: "Make a Wishing Well"
	quest.59D00BCFD888DADF.quest_desc: [
		"Obtain the Occult Ender Lead, the most advanced tether in this branch."
		""
		"It fills RAD3's unavailable Wavebinder position with a functional item from this pack."
	]
	quest.59D00BCFD888DADF.quest_subtitle: "Occult binding"
	quest.59D00BCFD888DADF.title: "Occult Ender Lead"
	quest.59E68086A8B99EA7.quest_desc: [
		"The &c&lPyromancer&r (different from the Pie Romancer) is another Neutral Mob added by &lIron's Spells&r. He will maybe set Mobs that are close to him on &cfire&r though... \n\nYou can trade him all things &cFire&r, Ink, and even &cFire Scrolls&r. \n\nIf you want to risk all the hair on your body by fighting him be prepared, he has 60 Hearts. He will set you on &cFire&r with &cFire Spells&r, not even a question. \n\nOn death he will drop Arcane Essence, Inks, &cFire Runes&r, and &cFire Spells&r!"
		"{image:irons_spellbooks:textures/quests/spells_pyromancer.png width:100 height:200 align:center}"
	]
	quest.59E68086A8B99EA7.title: "&c&lPyromancer"
	quest.59EA669ABE8ABD8D.quest_desc: ["Receive Gold Coins for premium shop use."]
	quest.59EA669ABE8ABD8D.title: "Silver to Gold Exchange"
	quest.5A11A2FC20E5CE2A.quest_desc: ["Build the Barracks to establish organized military defense. This is the main step from scattered guard towers to a coordinated colony army."]
	quest.5A11A2FC20E5CE2A.quest_subtitle: "Build a Barracks"
	quest.5A11A2FC20E5CE2A.title: "Barracks"
	quest.5A6266BFD238B9B9.quest_desc: ["Mine diamonds to open the next equipment and enchanting path."]
	quest.5A6266BFD238B9B9.title: "Diamonds Below"
	quest.5AAD08944CDC97B0.title: "Lucky Egg"
	quest.5AFB6E15C24246D2.quest_subtitle: "Prepare the core of a Geode Shelf"
	quest.5AFB6E15C24246D2.title: "Budding Stability"
	quest.5AFFF6D2AB06C8E5.quest_desc: ["Enter the world and claim the first supplies for the road ahead."]
	quest.5AFFF6D2AB06C8E5.title: "Awakening"
	quest.5B013A3A37D6902B.quest_desc: ["You can find the fragments of Ancient Knowledge spread out in the Chests of the &9Ancient City&r. \n\nYou'll also need &9Echo Shards&r to 1. Combine the Fragments to learn of the &9Spells&r and 2. Actually make the &9Spells&r."]
	quest.5B013A3A37D6902B.title: "Into the Ancient City"
	quest.5B22BA665F0E928F.quest_desc: ["Trigger a rare find from the Station branch. Keep the travel network active until the addon rewards exploration and trade luck."]
	quest.5B22BA665F0E928F.title: "Rare Find"
	quest.5B26284490667F2E.quest_desc: ["Find the Burning Arena before challenging Ignis."]
	quest.5B26284490667F2E.title: "Burning Arena"
	quest.5B737BAFEFFBB698.quest_desc: ["Complete a recycling action through the Trade Post system. This proves the building is doing more than storing junk."]
	quest.5B737BAFEFFBB698.title: "Reduce, Reuse, Recycle"
	quest.5D609E5854B16471.quest_desc: ["Enchant an item at 100% Arcana. High Arcana is the cleanest way to make rare and multi-enchantment rolls more consistent at endgame."]
	quest.5D609E5854B16471.quest_subtitle: "Stat Route - Full Arcana"
	quest.5D609E5854B16471.title: "Arcane Power"
	quest.5D670C12B672F45F.quest_desc: ["Collect cobblestone, granite, andesite, and diorite after the Builder route is active. These materials introduce the mixed-stone side path."]
	quest.5D670C12B672F45F.title: "Got Stone?"
	quest.5D94C77F410EB746.quest_desc: ["Upgrade your earnings into a Gold Trade Coin. This confirms your Marketplace can support larger trade payouts and stronger buying power."]
	quest.5D94C77F410EB746.title: "High Roller"
	quest.5DE863C3FB6492BE.quest_desc: ["{image:irons_spellbooks:textures/quests/spells_outfit_cultist.png width:60 height:100 align:center}"]
	quest.5DE863C3FB6492BE.title: "&4Cultist Outfit"
	quest.5E56057555772780.quest_desc: ["Unlock the Trade Post addon branch after your Town Hall is established. This opens colony trade, tourism, pets, recycling, travel, and outpost goals."]
	quest.5E56057555772780.title: "Trade Post Charter"
	quest.5ED368C926E5F32C.quest_desc: ["There is a final class of &3Spells&r I forgot to mention. Well all knowledge of these &9Spells&r have been forgotten so it's not just me. \n\nIn order to regain memories we need to walk, quietly, down memory lane. Which happens to be the &9Ancient City&r."]
	quest.5ED368C926E5F32C.title: "The Last Class..."
	quest.5F4F7ABD18E5EF9C.quest_desc: [
		"&6Treasure enchantments&r are special enchantments that are typically unavailable in the Enchanting Table. However, this can be remedied with a &6Deepshelf of Arcane Treasures&r."
		""
		"Placing this bookshelf in a valid slot will cause treasure enchantments to appear while enchanting. Bear in mind that most &cCurses&r are treasure enchantments."
	]
	quest.5F5DB67F6A470C73.quest_desc: ["Grow the colony military to thirty guards. At this size, defense becomes a major system instead of a small support role."]
	quest.5F5DB67F6A470C73.title: "Thirty Guards"
	quest.5F719198E56C9417.quest_desc: ["Upgrade an Endshelf into a Draconic Endshelf. Draconic shelves provide the highest Eterna cap in this chain and form the core of level 100 setups."]
	quest.5F719198E56C9417.quest_subtitle: "Step 12 - Draconic Shelf Core"
	quest.5F719198E56C9417.title: "The Final Bookshelf"
	quest.5F73123B6664C1A9.quest_desc: ["Craft an Etherium tool or weapon after forging Etherium."]
	quest.5F73123B6664C1A9.title: "Etherium Arsenal"
	quest.5F895C96E1163335.quest_desc: ["Obtain a Recall Potion before relying on emergency escape tools."]
	quest.5F895C96E1163335.title: "Recall Potion"
	quest.5FC01763770A062E.quest_desc: ["Build the Town Hall to establish the administrative center of the colony. Upgrading it raises the settlement ceiling and anchors future expansion."]
	quest.5FC01763770A062E.title: "Town Hall Built"
	quest.607B8B7D560BA6A8.quest_desc: ["They can be useful for precisely adjusting stats for infusion recipes, but not much else."]
	quest.607B8B7D560BA6A8.title: "The Weird Shelves"
	quest.60CB4B59DF9639E5.quest_desc: ["Locate an Ancient City before pushing deeper into high-risk exploration."]
	quest.60CB4B59DF9639E5.title: "Ancient City"
	quest.60DCDD30EE93F6D2.quest_desc: ["Receive a random food reward. Basic meals are common; golden food is rare."]
	quest.60DCDD30EE93F6D2.title: "Food Supply Crate"
	quest.60FAD8BF235E381B.title: "&bRare&r Ink"
	quest.615C3E012B2DECD3.quest_desc: ["&eSpellbooks&r! Where else would you put &3Spells&r? \n\nYou can add &3Scrolls&r to a &eSpellbook&r by putting both into an Inscription Table. They have a certain amount they can hold but no longer having to worry about Rarity. \n\nWhen &3Scrolls&r are added to your &eSpellbook&r they won't be consumed but rather Mana will be consumed."]
	quest.615C3E012B2DECD3.title: "&eSpellBooks&r!"
	quest.622AEF3DA469F1C9.quest_desc: [
		"Find the record dedicated to Eterna, the enchanting power stat."
		""
		"This collectible replaces RAD3's unavailable Sacrificial Shelf node."
	]
	quest.622AEF3DA469F1C9.quest_subtitle: "The melody of power"
	quest.622AEF3DA469F1C9.title: "Melody of Eterna"
	quest.62DA05A109DCFA92.quest_desc: ["Continue the Pillager bounty with a larger target. Complete it to unlock the next tier."]
	quest.635C194330BA9376.quest_desc: ["Continue the Enderman bounty with a larger target. Complete it to unlock the next tier."]
	quest.637C87D8968CD51A.title: "&aUncommon&r Ink"
	quest.639531AB27DCD267.quest_desc: ["&7Runes&r are how we make our Classes and their parts. To get a &7Blank Rune&r you can either kill the &4&lDead King&r or wipe clean an Inscribed Rune with a Shriving Stone. \n\nThere's 8 different classes (1 secret one) each having their own &3Scrolls&r, Focus Material, Upgrades, and Outfits. "]
	quest.639531AB27DCD267.title: "&lClasses"
	quest.63B158B616DF7AFC.quest_desc: ["Acquire a Twisted Heart after accepting the Cursed Ring path."]
	quest.63B158B616DF7AFC.title: "Twisted Heart"
	quest.641888DC7BC40AA9.quest_desc: [
		"The heavily guarded &aFortress&r is home to the &a&lArchevoker&r and his followers. \nYou'll know you see it by its huge Spruce Walls and the giant Stone &aFortress&r inside of them. \n\nIllagers, Vindicators, &aEvokers&r, and Ravagers can be found within the Walls and &aFortress&r. Once you get past them you can find your way up the stairs, parkour to the Roof, and meet the &a&lLeader of the Fort&r at the top. \n\nWith it being heavily guarded of course there is a ton of loot within the &aFort&r."
		"{image:irons_spellbooks:textures/quests/spells_evokerfort.png width:200 height:100 align:center}"
	]
	quest.641888DC7BC40AA9.title: "&aEvoker Fort"
	quest.647F95EED59927B7.quest_desc: ["Build the Cook Hut to turn raw ingredients into better meals. A Cook improves food quality and helps keep citizens productive during longer projects."]
	quest.647F95EED59927B7.title: "Cook Hut"
	quest.64A92D70448C1445.quest_desc: [
		"Find the record dedicated to Arcana, the enchanting rarity stat."
		""
		"This small leaf restores the final open position beside the compatible Geode Shelf branch."
	]
	quest.64A92D70448C1445.quest_subtitle: "The melody of rarity"
	quest.64A92D70448C1445.title: "Arcana in the Clouds"
	quest.652A14E17DDE97E6.quest_desc: ["Another that needs the Ruined Book to Craft. You can find the Ruined Books in &9Ancient City&r Chests. \n\nYou'll also need Dragon Skin which drops from the &dEnder Dragon&r! \n\nIt will have 12 &3Spell&r Slots and give a boost to &dEnder Spells&r!"]
	quest.652A14E17DDE97E6.title: "&dDragonskin Spell Book"
	quest.6576C98A4DB6221C.quest_desc: ["Obtain the Flame Eye to open the Burning Arena route."]
	quest.6576C98A4DB6221C.title: "Flame Eye"
	quest.65D23E7683812E26.quest_desc: ["Have a citizen eat rotten flesh in a pinch. It is not ideal food, but it proves the colony can survive rough moments while better food production is being built."]
	quest.65D23E7683812E26.title: "Emergency Rations"
	quest.66205FF8691A9FD7.quest_desc: ["Find the Ruined Citadel before challenging the Ender Guardian."]
	quest.66205FF8691A9FD7.title: "Ruined Citadel"
	quest.66762A4743104157.quest_desc: ["Another craftable &eSpellbook&r, this one's a little more expensive! It'll need Hogskin which is a drop from Hoglins. \n\nThis one can hold 8 &3Spells&r which is technically still on the low side but it's better!"]
	quest.66762A4743104157.title: "Apprentice's Spell Book"
	quest.66BBED961CBFADF3.quest_desc: ["Find the Cursed Pyramid before challenging the Ancient Remnant."]
	quest.66BBED961CBFADF3.title: "Cursed Pyramid"
	quest.67212BA264C3C792.quest_desc: [
		"Upgrade the first tether into a reliable Ender Lead."
		""
		"This branch replaces an unavailable RAD3 shelf while keeping the original position and connection."
	]
	quest.67212BA264C3C792.quest_subtitle: "A stronger tether"
	quest.67212BA264C3C792.title: "Ender Lead"
	quest.67688DF5FCCD3447.quest_desc: ["Defeat the Kraken without taking a hit for a mastery reward."]
	quest.67688DF5FCCD3447.title: "Flawless Kraken"
	quest.67A587F4BAD76C70.quest_desc: ["The most basic &eSpellbook&r, which also makes it the cheapest! \n\nIt can only hold a total of 5 &3Spells&r."]
	quest.67A587F4BAD76C70.title: "Flimsy Journal"
	quest.67D40A1A9332C03D.title: "&6Legendary&r Ink"
	quest.67E8B8DCFC93F832.quest_desc: ["Build the Warehouse to centralize colony storage. This becomes the main inventory hub that delivery workers use to move items between buildings."]
	quest.67E8B8DCFC93F832.title: "Warehouse"
	quest.68500900087F92BC.quest_desc: ["Teach the colony how to craft doors. Builders request them often, so this recipe reduces a common manual crafting bottleneck."]
	quest.68500900087F92BC.title: "Teach Doors"
	quest.68B44B9E939F4228.quest_desc: [
		"At the top of the &aFort&r lies the &a&lArchevoker&r. Hostile to only the Player and whoever attacks him. \n\nHe has 60 Hearts, and attacks like a normal &aEvoker&r plus more! &aFireworks&r, &aShield&r, and &aBlast of Wind&r! \n\nOnce killed he will drop Arcane Essence, Inks, &aEvokation Runes&r, &aEvokation Scrolls&r, and rare drop of the &aGrimore of Evokation&r!"
		"{image:irons_spellbooks:textures/quests/spells_evoker.png width:100 height:200 align:center}"
	]
	quest.68B44B9E939F4228.title: "&a&lArchevoker"
	quest.68C6BAA469343646.quest_desc: ["Enchant with maximum Eterna and Arcana while keeping Quanta at 0%. This creates a high-power setup for clean, predictable enchanting."]
	quest.68C6BAA469343646.quest_subtitle: "Endgame Route - Stable Power"
	quest.68C6BAA469343646.title: "Stable Power"
	quest.68C704D802430B1D.quest_desc: ["Defeat the Underworld Knight without taking a hit for a mastery reward."]
	quest.68C704D802430B1D.title: "Flawless Underworld Knight"
	quest.68FC81E133443E76.quest_desc: ["Build the Library to support knowledge and worker development. It strengthens the colony infrastructure around learning, records, and advanced professions."]
	quest.68FC81E133443E76.quest_subtitle: "Build a Library"
	quest.68FC81E133443E76.title: "Library"
	quest.6963EC8A71D66AE3.quest_desc: [
		"Deep in the muddy Mangrove Swamps lies the refuge of the hermit like Mob called the &2&lApotheocarist&r. \n\nWith nobody near, and only what he needs for his Potions is around. \n\nYou can find the &2&lApotheocarist&r in his &2Hut&r. \n\nThere you can also find Cauldrons and Brewing Stands with Potions!"
		"{image:irons_spellbooks:textures/quests/spells_magrovehut.png width:200 height:100 align:center}"
	]
	quest.6963EC8A71D66AE3.title: "&2Mangrove Hut"
	quest.696BDC29ACCBBE29.quest_desc: ["Complete the Undertaker Totem milestone to improve recovery after deaths. This supports colony stability during dangerous phases."]
	quest.696BDC29ACCBBE29.title: "Undertaker Totem"
	quest.69763C2E2F454A73.quest_desc: ["&c&lFire&r is obviously related to &cFire&r. Most of the Scrolls are with using &cFire&r to burn and hurt things. \n\n&c&lFire's&r Focus Material is &cBlaze Rods&r. You can craft &cFire Runes&r or get them from killing the &c&lPyromancer&r. \n\nIts &cScrolls&r are &cLight Red&r with &8Grey&r text."]
	quest.69763C2E2F454A73.title: "&c&lFire"
	quest.69838E3F12218D68.quest_desc: [
		"Scroll Forge, you can guess what it does! \n\nIt makes &3Scrolls&r! \n\nAdd an Ink to set the Rarity. Paper for the actual &3Scroll&r. Then the Item of what type of &3Spell&r you want (&cBlaze Rod&r for &c&lFire&r, &2Poisonous Potato&r for &2&lNature&r, ETC). Finally chose the &3Spell&r you want and it'll be created!"
		"{image:irons_spellbooks:textures/quests/spells_scroll_gui.png width:150 height:100 align:center}"
	]
	quest.69967785A2080B94.quest_desc: ["Use the wishing system once. Pick a useful wish and complete it to unlock this side of the addon progression."]
	quest.69967785A2080B94.title: "Make a Wish"
	quest.69EAF1072D492F1A.quest_desc: ["Obtain an Ancient Tome for knowledge-based rewards and later utility. Keep it as a useful progression item while the colony grows."]
	quest.69EAF1072D492F1A.quest_subtitle: "Keep one in your hotbar"
	quest.69EAF1072D492F1A.title: "Ancient Tome"
	quest.6A60B76053393288.quest_desc: ["Build the Smeltery to process metals for tools and equipment. It becomes a core part of advanced production chains."]
	quest.6A60B76053393288.quest_subtitle: "Builder a Smelter"
	quest.6A60B76053393288.title: "Smeltery"
	quest.6B0CE8AD86991E28.quest_desc: ["Build the Composter to support farms and handle organic waste. This keeps food production moving and helps close the farming loop."]
	quest.6B0CE8AD86991E28.quest_subtitle: "Build a Composter Hut"
	quest.6B0CE8AD86991E28.title: "Composter"
	quest.6B26495A9E7D77FC.quest_desc: ["Grow the colony to five citizens. This is the first sign that recruitment, housing, and food are all starting to function."]
	quest.6B26495A9E7D77FC.title: "Population 5"
	quest.6BB0C51EE8CA5966.quest_desc: ["Build the Miner Hut to start gathering stone and ores through colony labor. This gives your settlement a renewable source of basic construction materials."]
	quest.6BB0C51EE8CA5966.quest_subtitle: "Build a Mine"
	quest.6BB0C51EE8CA5966.title: "Miner Hut"
	quest.6C5AD5C4C843A11D.quest_desc: ["Trigger the Perpetual Stew milestone. Keep Trade Post food and service systems moving until the stew route completes."]
	quest.6C5AD5C4C843A11D.title: "Runs on Stew"
	quest.6CE7115DA2B23776.quest_desc: ["Not much better than the Flimsy one... \n\nThis can hold a single &3Spell&r more than the Flimsy Journal! That's one more very powerful &3Spell&r at the ready!"]
	quest.6CE7115DA2B23776.title: "Ironbound Journal"
	quest.6D1C9E652CE9007A.quest_desc: ["Assemble a full iron armor set before taking harder fights."]
	quest.6D1C9E652CE9007A.title: "Iron Armor Set"
	quest.6D232F6D8E8DA546.quest_desc: [
		"Very popular around Halloween!"
		"{image:irons_spellbooks:textures/quests/spells_outfit_plagued.png width:60 height:100 align:center}"
	]
	quest.6D232F6D8E8DA546.title: "&2Plagued Outfit"
	quest.6D56AD1BEC644A10.quest_desc: ["Build the Archery to train ranged defenders. Archers give your military coverage against flying, distant, and dangerous enemies."]
	quest.6D56AD1BEC644A10.quest_subtitle: "Build an Archery"
	quest.6D56AD1BEC644A10.title: "Archery"
	quest.6D80D38812B5B2D0.quest_desc: ["Discover a Spellstone to open the relic crafting branch."]
	quest.6D80D38812B5B2D0.title: "First Spellstone"
	quest.6DB5732177AABB87.quest_desc: [
		"The biggest and hardest Structure from &lIron's Spells&r. \n\nThese are deep underground structures similar to Trial Chambers. You can also use Wayward Compasses to help find it! \n\nIn it are plenty of Spawners, Trial Spawners, and of course Loot. \n\nThe most important room is the Throne Room, once you arrive there, the Skeleton of the &4&lDead King&r will reanimate! (If it doesn't you might need to click him)."
		"{image:irons_spellbooks:textures/quests/spells_catacombs.png width:200 height:100 align:center}"
	]
	quest.6DB5732177AABB87.title: "&4Catacombs"
	quest.6E023211E6D1194F.quest_desc: ["Prepare the Wishing Well route with Mixed Stone. This step introduces the special wish mechanics without overwhelming the main colony path."]
	quest.6E023211E6D1194F.title: "Make a Wishing Well"
	quest.6E75402CC8F32092.quest_desc: ["Receive a random utility reward. Arrows and torches are common; Ender Pearls and Eyes are rare."]
	quest.6E75402CC8F32092.title: "Utility Supply Crate"
	quest.6F60F67F81C1CC7C.quest_desc: ["Create an Endshelf with Infused Dragon's Breath. The End branch begins after Sculk progression and bridges the table into the final Eterna tier."]
	quest.6F60F67F81C1CC7C.quest_subtitle: "Step 11 - End Branch"
	quest.6F60F67F81C1CC7C.title: "Dragon-Slaying Enchanter"
	quest.6FC427158E014F38.quest_desc: ["Complete the major Enigmatic branches to finish this chapter."]
	quest.6FC427158E014F38.title: "Beyond the Curse"
	quest.71FCF06A98CC66D7.quest_desc: ["Obtain a Clipboard to inspect citizens, work orders, and colony problems. It is one of the best tools for quickly understanding what your settlement needs next."]
	quest.71FCF06A98CC66D7.title: "Clipboard"
	quest.7270A37E31A70C91.quest_desc: ["&6&lHoly&r is for all the Medic/Support players. It's mostly meant for healing and helping. \n\n&6&lHoly's&r Focus Material is &6Divine Pearls&r which are crafted. You can make Runes with those or kill the &6&lPriest&r to get &6Holy Runes&r. \n\n&6Holy Scrolls&r are &fWhite&r with &6Gold&r texts."]
	quest.7270A37E31A70C91.title: "&6&lHoly"
	quest.72AB70FD8D8FABBF.title: "On a Highway to..."
	quest.72C749AD9F1C634E.quest_desc: ["Build citizen housing so the colony can grow beyond temporary beds. More homes mean more workers, more jobs, and smoother expansion."]
	quest.72C749AD9F1C634E.quest_subtitle: "Build a Residence"
	quest.72C749AD9F1C634E.title: "Citizen Housing"
	quest.73D6B980D35082A0.quest_desc: ["This one takes awhile to explain so have patience. \n\nFirst, find an &aEvoker Fort&r. \nNext, find a Research Book hidden in it. Then, have a Trader who's hostage in the &aFort&r translate it. (Like our hostage Quest Translators!) \nOnce, it's translated bring it to a &6&lPriest&r in a &6Village&r to trade it for the &eSpell Book&r! \n\nIt gives a boost to &6Holy Spells&r and don't worry the hostage Traders are very very rare, keep looking!"]
	quest.73D6B980D35082A0.title: "&6Villager Bible"
	quest.7408CCF998D9CD37.quest_desc: ["A Craftable &eSpell Book&r... yeah it's not easy to craft. \n\nHardest to get would be the Ruined Book, which you can find in &9Ancient City&r Chests. &4Blood Vials&r can be obtained from either putting a Mob (or even yourself) into a Cauldron above a Campfire or an Alchemical Cauldron. &5Bottle O' Lightning&r comes from using a Bottle on a Charged Creeper. \n\nOnce you do all that you can craft the Ancient Codex. Its 12 &3Spell&r Slots is very helpful!"]
	quest.7408CCF998D9CD37.title: "Ancient Codex"
	quest.740AAF52DF9EBE8F.quest_desc: ["Obtain a Fishing Tome to focus enchanting results toward fishing rods."]
	quest.740AAF52DF9EBE8F.quest_subtitle: "Fishing enchantments"
	quest.740AAF52DF9EBE8F.title: "Tome of the Fishers"
	quest.743D7D9204915A13.quest_desc: ["Handle a citizen burial and keep the colony stable after loss. This marks the point where recovery systems become part of colony management."]
	quest.743D7D9204915A13.title: "Burial Duty"
	quest.74AAE9C994E2993F.quest_desc: ["To hit level 75, you will need to upgrade your Deepshelves. Doing this requires materials only found in the &0Deep Dark&r. &1Echo Shards&r may be looted from the Ancient City, and &1Sculk&r may be collected with Silk Touch."]
	quest.74AAE9C994E2993F.quest_subtitle: "Reaching Level 75"
	quest.74AF1CE2FEEF22BC.quest_desc: ["Defeat the Ancient Remnant and finish the desert route."]
	quest.74AF1CE2FEEF22BC.title: "Ancient Remnant"
	quest.74C114D0C0D4D374.quest_desc: ["Craft the Hospital hut block to prepare medical support. Health services become important as the population grows and danger increases."]
	quest.74C114D0C0D4D374.quest_subtitle: "Build a Hospital"
	quest.74C114D0C0D4D374.title: "Hospital Hut"
	quest.74D320BC2CE035A6.quest_desc: ["Defeat the Netherite Monstrosity and finish the forge route."]
	quest.74D320BC2CE035A6.title: "Netherite Monstrosity"
	quest.7500C6B1E70EDE99.quest_desc: ["Enchant an item at level 100. This is the main power cap of Apothic Enchanting and requires a tuned setup built around End-tier shelves."]
	quest.7500C6B1E70EDE99.quest_subtitle: "Step 13 - Level 100 Enchanting"
	quest.7500C6B1E70EDE99.title: "Draconic Enchanting"
	quest.7553083A4719E09B.quest_desc: ["Finish the final Zombie bounty for the largest reward in this chain."]
	quest.75599A9909C7A8C8.quest_desc: ["Make sure a citizen successfully eats food. A fed colony works more reliably, and this confirms your early food supply is reaching the people who need it."]
	quest.75599A9909C7A8C8.title: "First Meal"
	quest.75CC6A3ABF5E66E2.quest_desc: ["Grow the colony to seventy-five citizens. This is a late colony milestone that demands strong logistics, food, housing, and defense."]
	quest.75CC6A3ABF5E66E2.title: "Population 75"
	quest.761C7DF67620DC29.quest_desc: ["Continue the Creeper bounty with a larger target. Complete it to unlock the next tier."]
	quest.76558D23A70AFF78.title: "&bIce&r Upgrade Orb"
	quest.767FA524371C9480.quest_desc: ["Hunt Endermen to start this bounty chain. The next tier asks for a larger kill count."]
	quest.77CADB958D24D541.quest_desc: [
		"Sometimes, it is desirable to avoid certain enchantments entirely during the enchanting process. The &bSeashelf of Aquatic Filtration&r allows you to do just that."
		""
		"The shelf allows you to insert up to six single-enchantment books in it, preventing those enchantments from appearing."
		""
		"To use it, simply insert a single-enchantment book of an enchantment you wish to blacklist. The enchantment will then no longer be available in the Enchanting Table. The shelf will also gain &cEterna&r and &5Arcana&r based on the number of books inserted."
		""
		"&oNote: books can be inserted the same way you use a chiseled bookshelf, and the shelf must be in a valid bookshelf slot to operate. Blacklisted enchantments will be reflected in the Enchanting Info Screen&r"
	]
	quest.7870800C28A7E199.quest_desc: ["Craft the Chicken Herder hut block to support poultry production. Chickens provide eggs, feathers, and food for the colony chain."]
	quest.7870800C28A7E199.title: "Chicken Herder Hut"
	quest.7878E38C1FFB963D.quest_desc: [
		"&aEterna&r"
		""
		"&aEterna&r is the primary stat of enchanting. Each point of &aEterna&r increases the maximum enchanting level by two. Some blocks can only provide &aEterna&r up to a certain maximum value."
	]
	quest.7878E38C1FFB963D.quest_subtitle: "If you aren't fond of the Nether, you can also venture to the Ocean, and create Seashelves instead."
	quest.789AA17C4D02BE94.quest_desc: ["Defeat the Yeti and unlock its flawless challenge."]
	quest.789AA17C4D02BE94.title: "Yeti"
	quest.78AA7BFABBFB9973.quest_desc: ["&2&lNature's&r &eSpell Book&r. \n\nIt has 10 &3Spells&r and gives a boost to &2Nature Spells&r! \n\nYou need a Rotten Spell Book to craft it though..."]
	quest.78AA7BFABBFB9973.title: "&2Druidic Tome"
	quest.78C886330EF984E8.quest_desc: ["Obtain the Void Eye to open the Ruined Citadel route."]
	quest.78C886330EF984E8.title: "Void Eye"
	quest.7923F12E91B8E241.quest_desc: ["Obtain your first Trade Coin. This confirms the Marketplace economy is working and starts the currency progression."]
	quest.7923F12E91B8E241.title: "Big Spender"
	quest.792FFB9899C14E0A.quest_desc: ["Build a level 1 Marketplace. This is the economic core of Trade Post and lets the colony begin minting Trade Coins from unwanted resources."]
	quest.792FFB9899C14E0A.title: "Marketplace"
	quest.7966BC6250F38D48.quest_desc: ["Make one wish through the Trade Post wishing system. This completes the addon wish progression after the Wishing Well step."]
	quest.7966BC6250F38D48.title: "Make a Wish"
	quest.7A73657F0C2B5062.quest_desc: ["Craft a Hellshelf with Nether materials. This shelf starts the Hell branch, raising Eterna for stronger enchant levels and Quanta for more unstable rolls."]
	quest.7A73657F0C2B5062.quest_subtitle: "Step 04A - Hell Branch"
	quest.7A73657F0C2B5062.title: "The Chaos of Hell"
	quest.7B5E2CD676A1A1C4.quest_desc: ["Build the Baker to improve food quality and variety. Better meals help keep citizens fed during larger building projects."]
	quest.7B5E2CD676A1A1C4.quest_subtitle: "Build a Bakery"
	quest.7B5E2CD676A1A1C4.title: "Baker"
	quest.7B62D55B886496AF.quest_desc: ["You now have access to better options for increasing other stats. On top of the bonuses from Hellshelves and Seashelves, you may now also create &4Sightshelves&r  to increase your &8Clues&r."]
	quest.7B62D55B886496AF.quest_subtitle: "Clues +1"
	quest.7BCF084B6C070D66.quest_desc: ["Acquire the Darkest Scroll before attempting cursed scrollcraft."]
	quest.7BCF084B6C070D66.title: "Darkest Scroll"
	quest.7C79BCE482A06199.quest_desc: ["&b&lIce&r is all about Winter time Spells. Using &bIce&r and &bSnow&r to chill and harm enemies. \n\n&b&lIce's&r Focus Material is the &bFrozen Bone&r which are drops from &bStrays&r. You can use those to craft the &bIce Rune&r or kill the &b&lCryomancer&r to get it. \n\nIts &bScrolls&r are &bLight Blue&r with a &9Darker Blue&r text."]
	quest.7C79BCE482A06199.title: "&b&lIce"
	quest.7D50111C051FD8E5.quest_desc: ["Build a level 1 Pet Shop. This opens the pet training branch and adds functional companions to the colony workflow."]
	quest.7D50111C051FD8E5.title: "Pet Shop"
	quest.7D7BFA807275B79B.quest_desc: ["Locate an Ocean Monument and gather tools for underwater progress."]
	quest.7D7BFA807275B79B.title: "Ocean Monument"
	quest.7F85669FEA41CD97.quest_desc: [
		"The Neutral protector of the &6Village&r. He will attack all nearby Hostile Mobs. Like an Iron Golem but he look familiar for some reason? Could it be someone we know in a costume? \n\nYou can trade Healing Potions with him and Emeralds for a Furled Map which will soon be made to help against &aEvoker Forts&r! \n\nIf you do wish to kill him he will repeatedly attack you with &6Holy Spells&r. He will also Heal himself when getting low. \n\nOnce killed he will drop Arcane Essence, Inks, &6Holy Runes&r, and &6Holy Scrolls&r."
		"{image:irons_spellbooks:textures/quests/spells_priest.png width:100 height:200 align:center}"
	]
	quest.7F85669FEA41CD97.title: "&6&lPriest"
	quest.7F9A15CD13D2D7CE.quest_desc: ["Continue the Zombie bounty with a larger target. Complete it to unlock the next tier."]
	quest.7FABA4362B1747BD.quest_desc: ["Continue the Piglin Brute bounty with a larger target. Complete it to unlock the next tier."]
	quest.7FC54AF87CBDD222.quest_desc: [
		"&5Ancient Battlegrounds&r are only a fragment of the past. \n\nWho knows what happened. \n\nWho knows who fought who. All we have now are parts of the walls and these &5Piles of Armor&r. Might as well just pick them up by Mining them with your Pickaxe."
		"{image:irons_spellbooks:textures/quests/spells_battleground.png width:200 height:100 align:center}"
	]
	quest.7FC54AF87CBDD222.title: "&5Ancient Battleground"
	quest.84390AE7CFC99D39.quest_desc: ["Continue the Evoker bounty with a larger target. Complete it to unlock the next tier."]
	quest.84A4755ADAD80AB9.quest_desc: ["Finish the final Enderman bounty for the largest reward in this chain."]
	quest.95456713042B648A.quest_desc: ["Finish the final Skeleton bounty for the largest reward in this chain."]
