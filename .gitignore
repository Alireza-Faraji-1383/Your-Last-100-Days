# =============================================================
# Minecraft Modpack .gitignore
# NeoForge 1.21.1 / Prism Launcher
# =============================================================

# -------------------------------------------------
# OS
# -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------------------------------
# IDE / Editors
# -------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.sublime-workspace
*.sublime-project
.claude/

# -------------------------------------------------
# ProbeJS temp
# -------------------------------------------------
.probe/
kubejs/documentation/
kubejs/**/jsconfig.json

# -------------------------------------------------
# Launcher metadata (auto-generated)
# -------------------------------------------------
.curseclient
minecraftinstance.json

# -------------------------------------------------
# Runtime logs & crash reports
# -------------------------------------------------
logs/
crash-reports/
debug/
*.log
*.log.*
hs_err_pid*.log

# -------------------------------------------------
# World saves & backups
# -------------------------------------------------
saves/
backup/
server-resource-packs/
blueprints/

# -------------------------------------------------
# User-specific runtime files
# -------------------------------------------------
options.txt
optionsof.txt
usercache.json
usernamecache.json
command_history.txt
TrashSlotSaveState.json
patchouli_data.json
emi.json
fancymenu_data/

# -------------------------------------------------
# Xaero maps & waypoints (personal per-player data)
# -------------------------------------------------
xaero/
XaeroWaypoints_BACKUP*/

# -------------------------------------------------
# Screenshots & downloads
# -------------------------------------------------
screenshots/
downloads/

# -------------------------------------------------
# Caches (auto-generated by mods)
# -------------------------------------------------
dynamic-data-pack-cache/
dynamic-resource-pack-cache/
.cache/
local/

# -------------------------------------------------
# Large binaries: mods, resource packs, shaders
# -------------------------------------------------
mods/
resourcepacks/
shaderpacks/
texturepacks/

# -------------------------------------------------
# Launcher icon
# -------------------------------------------------
icon.png

# -------------------------------------------------
# Touhou Little Maid custom pack (huge binary assets)
# -------------------------------------------------
tlm_custom_pack/

# -------------------------------------------------
# Config: backup files (*.bak auto-generated by mods)
# -------------------------------------------------
config/*.bak
config/**/*.bak
config/**/*-had-error.json5

# -------------------------------------------------
# Config: auto-generated / user-specific (changes every launch)
# -------------------------------------------------
config/oculus.properties
config/configured-client.properties
config/fml.toml
config/modernfix-mixins.properties
config/embeddium-fingerprint.json
config/embeddium-options.json
config/embeddium-mixins.properties
config/entity_model_features.json
config/entity_texture_features.json
config/etf_warnings.json
config/emi.css
config/xaerohud.txt
config/xaeropatreon.txt

# JEI: user sorting/display preferences (changes every session)
config/jei/jei-client.ini
config/jei/jei-colors.ini
config/jei/jei-debug.ini
config/jei/jei-mod-id-format.ini
config/jei/ingredient-list-mod-sort-order.ini
config/jei/ingredient-list-type-sort-order.ini
config/jei/recipe-category-sort-order.ini
config/jei/blacklist.json

# Sound Physics: user audio preferences
config/sound_physics_remastered/

# Voice Chat: user audio settings (auto-generated)
config/voicechat/

# Sounds: auto-generated sound settings
config/sounds/

# Relics: auto-generated main config
config/relics.yaml

# FTB Quests lang (auto-generated translations)
config/ftbquests/quests/lang/*
!config/ftbquests/quests/lang/en_us.snbt
config/reliquified_lenders_cataclysm
config/relics

# -------------------------------------------------
# Project-owned branding and vanilla UI customization
# -------------------------------------------------
# These files are part of the distributable modpack, not local runtime noise.
!/icon.png
!/config/fml.toml

# Keep downloaded/user resource packs ignored, but version our lightweight UI pack.
!/resourcepacks/
/resourcepacks/*
!/resourcepacks/Y100D_Vanilla_Menu_1.21.1.zip

# NeoForge discovers this tiny early-window service directly from mods/. All
# downloaded gameplay mods remain ignored; only the pack-owned loader ships.
!/mods/
/mods/*
!/mods/y100d-early-loading-1.0.0+mc1.21.1-neoforge.jar
!/mods/y100d-raid-hud-1.0.0+mc1.21.1-neoforge.jar

# Reproducible loader build scratch
/tools/y100d-early-loading/build/
/tools/y100d-raid-hud/build/
config/jei/world
config/voicechat

# Project-owned Xaero entity radar categories. Keep the rest of Xaero's
# per-user maps, waypoints, profiles and runtime settings ignored.
!/config/xaero/
/config/xaero/*
!/config/xaero/minimap/
/config/xaero/minimap/*
!/config/xaero/minimap/default_radar_categories_client.json
